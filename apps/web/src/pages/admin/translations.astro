---
import AdminLayout from '../../layouts/AdminLayout.astro';
import getDb from '../../lib/db';

export const prerender = false;

// Mock data, real data will come from getDb()
const translations = [];
---

<AdminLayout title="Tərcümələr">
    <div class="mb-6 flex justify-between items-center">
        <h2 class="text-lg font-medium text-gray-800">Tərcümələr İdarəetmə</h2>
        <div class="flex gap-4">
            <input type="text" id="search-input" placeholder="Açar sözə görə axtar..." class="border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-[#F0692A] focus:border-[#F0692A]" />
            <button id="add-btn" class="bg-[#F0692A] hover:bg-orange-600 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm">
                + Yeni Tərcümə
            </button>
        </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" id="translations-table">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Açar (Key)</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/5">AZ</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/5">EN</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/5">RU</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {translations.length === 0 ? (
                        <tr id="empty-row">
                            <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500">Heç bir tərcümə tapılmadı.</td>
                        </tr>
                    ) : (
                        translations.map((t) => (
                            <tr class="hover:bg-gray-50 search-row" data-key={t.key}>
                                <td class="px-6 py-4 text-sm font-medium text-gray-900 break-all">{t.key}</td>
                                <td class="px-6 py-4 text-sm text-gray-500 break-words">{t.az}</td>
                                <td class="px-6 py-4 text-sm text-gray-500 break-words">{t.en}</td>
                                <td class="px-6 py-4 text-sm text-gray-500 break-words">{t.ru}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <button class="text-indigo-600 hover:text-indigo-900 mr-3 edit-btn" data-key={t.key}>Redaktə et</button>
                                    <button class="text-red-600 hover:text-red-900 delete-btn" data-key={t.key}>Sil</button>
                                </td>
                            </tr>
                        ))
                    )}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for Add/Edit -->
    <div id="form-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" id="modal-backdrop"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-xl sm:w-full">
                <form id="translation-form" class="p-6">
                    <div class="flex justify-between items-center mb-5">
                        <h3 class="text-lg font-medium text-gray-900" id="modal-title">Yeni Tərcümə</h3>
                        <button type="button" id="close-modal" class="text-gray-400 hover:text-gray-500">
                            <span class="sr-only">Bağla</span>
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    
                    <div class="space-y-4">
                        <input type="hidden" id="is-edit-mode" name="isEdit" value="false" />
                        
                        <div>
                            <label for="key" class="block text-sm font-medium text-gray-700">Açar (Key - format: namespace.key)</label>
                            <input type="text" name="key" id="key" required class="mt-1 focus:ring-[#F0692A] focus:border-[#F0692A] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md p-2 border font-mono" />
                            <p class="mt-1 text-xs text-gray-500">Açar dəyişdirilə bilməz, yalnız yaradılarkən təyin edilir.</p>
                        </div>
                        
                        <div>
                            <label for="az" class="block text-sm font-medium text-gray-700">Azərbaycanca (AZ)</label>
                            <textarea id="az" name="az" rows="2" class="mt-1 shadow-sm focus:ring-[#F0692A] focus:border-[#F0692A] block w-full sm:text-sm border border-gray-300 rounded-md p-2"></textarea>
                        </div>

                        <div>
                            <label for="en" class="block text-sm font-medium text-gray-700">İngiliscə (EN)</label>
                            <textarea id="en" name="en" rows="2" class="mt-1 shadow-sm focus:ring-[#F0692A] focus:border-[#F0692A] block w-full sm:text-sm border border-gray-300 rounded-md p-2"></textarea>
                        </div>

                        <div>
                            <label for="ru" class="block text-sm font-medium text-gray-700">Rusca (RU)</label>
                            <textarea id="ru" name="ru" rows="2" class="mt-1 shadow-sm focus:ring-[#F0692A] focus:border-[#F0692A] block w-full sm:text-sm border border-gray-300 rounded-md p-2"></textarea>
                        </div>
                    </div>
                    
                    <div class="mt-6 flex justify-end">
                        <button type="button" id="cancel-btn" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none mr-3">
                            Ləğv et
                        </button>
                        <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#F0692A] hover:bg-orange-600 focus:outline-none">
                            Yadda saxla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    // Search functionality
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        document.querySelectorAll('.search-row').forEach((row) => {
            const key = row.getAttribute('data-key')?.toLowerCase() || '';
            const rowText = (row as HTMLElement).innerText.toLowerCase();
            if (rowText.includes(query) || key.includes(query)) {
                (row as HTMLElement).style.display = '';
            } else {
                (row as HTMLElement).style.display = 'none';
            }
        });
    });

    const modal = document.getElementById('form-modal');
    const closeBtn = document.getElementById('close-modal');
    const cancelBtn = document.getElementById('cancel-btn');
    const addBtn = document.getElementById('add-btn');
    const backdrop = document.getElementById('modal-backdrop');
    const form = document.getElementById('translation-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title');
    const keyInput = document.getElementById('key') as HTMLInputElement;
    const isEditModeInput = document.getElementById('is-edit-mode') as HTMLInputElement;
    
    function openModal(isEdit = false) {
        modal?.classList.remove('hidden');
        if (modalTitle) modalTitle.textContent = isEdit ? 'Tərcüməni Redaktə et' : 'Yeni Tərcümə';
        if (isEditModeInput) isEditModeInput.value = isEdit.toString();
        
        if (keyInput) {
            keyInput.readOnly = isEdit;
            if (isEdit) keyInput.classList.add('bg-gray-100');
            else keyInput.classList.remove('bg-gray-100');
        }
        
        if (!isEdit) form?.reset();
    }
    
    function closeModal() {
        modal?.classList.add('hidden');
    }
    
    addBtn?.addEventListener('click', () => openModal(false));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        const isEdit = data.isEdit === 'true';
        delete data.isEdit;
        
        const url = `/api/translations/${data.key}`; // using key as identifier
        const method = isEdit ? 'PUT' : 'POST';
        
        // If POST we might send to a generic /api/translations instead
        const targetUrl = isEdit ? `/api/translations/${data.key}` : '/api/translations';
        
        try {
            const res = await fetch(targetUrl, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) window.location.reload();
            else alert('Xəta baş verdi.');
        } catch (err) {
            console.error(err);
        }
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const key = (e.currentTarget as HTMLButtonElement).getAttribute('data-key');
            if (confirm('Silmək istədiyinizə əminsiniz?')) {
                try {
                    const res = await fetch(`/api/translations/${key}`, { method: 'DELETE' });
                    if (res.ok) window.location.reload();
                } catch (err) {
                    console.error(err);
                }
            }
        });
    });
</script>
