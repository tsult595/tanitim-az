---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="About">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">About bölməsi</h1>
      <p class="mt-1 text-sm text-slate-500">Başlıq, mətn, düymə və şəkilləri idarə edin.</p>
    </div>

    <form id="about-form" class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="grid gap-5">
          <label class="text-sm font-medium text-slate-700">Başlıq
            <input id="about-title" required class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-2.5" />
          </label>
          <label class="text-sm font-medium text-slate-700">Description
            <textarea id="about-description" required rows="7" class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-2.5"></textarea>
          </label>
          <label class="text-sm font-medium text-slate-700">Button text
            <input id="about-button-text" required class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-2.5" />
          </label>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="mb-4 flex items-center justify-between">
          <div><h2 class="font-semibold text-slate-900">Şəkillər</h2><p class="text-sm text-slate-500">URL və alt mətnini dəyişə və silə bilərsiniz.</p></div>
          <button type="button" id="add-image" class="rounded-lg bg-orange-500 px-4 py-2 text-sm font-semibold text-white">Şəkil əlavə et</button>
        </div>
        <div id="about-images" class="space-y-3"></div>
      </div>

      <p id="about-error" class="hidden text-sm text-red-600"></p>
      <div class="flex items-center justify-end gap-3">
        <span id="about-success" class="hidden text-sm text-green-600">Yadda saxlanıldı</span>
        <button type="submit" class="rounded-lg bg-[#FE7930] px-6 py-2.5 text-sm font-semibold text-white">Yadda saxla</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { getAboutContent, updateAboutContent, type AboutImage } from '../../services/about.service';

  const initAboutAdmin = () => {
    const form = document.getElementById('about-form') as HTMLFormElement | null;
    const imagesElement = document.getElementById('about-images');
    if (!form || !imagesElement || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';
    const title = document.getElementById('about-title') as HTMLInputElement;
    const description = document.getElementById('about-description') as HTMLTextAreaElement;
    const buttonText = document.getElementById('about-button-text') as HTMLInputElement;
    const error = document.getElementById('about-error');
    const success = document.getElementById('about-success');
    let images: AboutImage[] = [];
    const showError = (message: string, cause?: unknown) => {
      if (cause) console.error(cause);
      error!.textContent = message;
      error!.classList.remove('hidden');
    };
    const renderImages = () => {
      imagesElement.innerHTML = images.map((image, index) => `
        <div class="grid gap-3 rounded-xl border border-slate-200 p-3 sm:grid-cols-[1fr_1fr_auto]">
          <input data-image-src="${index}" value="${image.src.replace(/"/g, '&quot;')}" placeholder="/aboutUs/example.png" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          <input data-image-alt="${index}" value="${image.alt.replace(/"/g, '&quot;')}" placeholder="Alt text" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          <button type="button" data-remove-image="${index}" class="rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50">Sil</button>
        </div>`).join('');
    };
    imagesElement.addEventListener('input', (event) => {
      const input = event.target as HTMLInputElement;
      const index = Number(input.dataset.imageSrc ?? input.dataset.imageAlt);
      if (input.dataset.imageSrc !== undefined) images[index].src = input.value;
      if (input.dataset.imageAlt !== undefined) images[index].alt = input.value;
    });
    imagesElement.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-image]');
      if (!button) return;
      images.splice(Number(button.dataset.removeImage), 1);
      renderImages();
    });
    document.getElementById('add-image')?.addEventListener('click', () => {
      images.push({ src: '', alt: '' });
      renderImages();
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error?.classList.add('hidden');
      success?.classList.add('hidden');
      try {
        await updateAboutContent({ title: title.value, description: description.value, buttonText: buttonText.value, images });
        success?.classList.remove('hidden');
      } catch (cause) {
        showError('About məlumatlarını saxlamaq mümkün olmadı.', cause);
      }
    });
    void getAboutContent().then((content) => {
      if (!content) return;
      title.value = content.title;
      description.value = content.description;
      buttonText.value = content.buttonText;
      images = content.images;
      renderImages();
    }).catch((cause) => showError('About məlumatlarını yükləmək mümkün olmadı.', cause));
  };

  initAboutAdmin();
  document.addEventListener('astro:page-load', initAboutAdmin);
</script>
