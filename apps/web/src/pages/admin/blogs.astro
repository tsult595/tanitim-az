---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Bloglar">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 flex items-center justify-between gap-4"><div><h1 class="text-2xl font-bold text-slate-900">Bloglar</h1><p class="mt-1 text-sm text-slate-500">AZ, RU və EN məzmununu ayrıca idarə edin.</p></div><button id="new-blog" type="button" class="rounded-lg bg-[#FE7930] px-4 py-2.5 text-sm font-semibold text-white">+ Yeni blog</button></div>
    <p id="blog-notice" class="hidden mb-4 rounded-lg px-4 py-3 text-sm" role="status" aria-live="polite"></p>
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white"><table class="w-full text-left text-sm"><thead class="border-b border-slate-200 bg-slate-50 text-slate-500"><tr><th class="px-5 py-4">Başlıq</th><th class="px-5 py-4">Dil</th><th class="px-5 py-4">Status</th><th class="px-5 py-4 text-right">Əməliyyatlar</th></tr></thead><tbody id="blogs-table"><tr><td colspan="4" class="p-8 text-center text-slate-400">Yüklənir…</td></tr></tbody></table></div>
  </div>
  <div id="blog-modal" class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-black/40 p-4 sm:items-center" role="dialog" aria-modal="true" aria-labelledby="blog-modal-title">
    <form id="blog-form" class="my-4 w-full max-w-3xl rounded-2xl bg-white p-6 shadow-xl sm:p-8"><div class="mb-6 flex items-center justify-between"><h2 id="blog-modal-title" class="text-lg font-bold">Yeni blog</h2><button id="close-blog" type="button" class="text-xl text-slate-500" aria-label="Bağla">×</button></div><input id="blog-id" type="hidden" />
      <div class="mb-5 flex gap-2 border-b border-slate-200" role="tablist"><button type="button" data-lang="az" class="lang-tab border-b-2 border-orange-500 px-3 py-2 text-sm font-semibold text-orange-600">AZ</button><button type="button" data-lang="ru" class="lang-tab px-3 py-2 text-sm font-semibold text-slate-500">RU</button><button type="button" data-lang="en" class="lang-tab px-3 py-2 text-sm font-semibold text-slate-500">EN</button></div>
      <p class="mb-4 text-xs text-slate-500">Hər dil üçün başlıq, slug, qısa məzmun, məzmun və SEO məlumatını ayrıca yadda saxlayın.</p>
      <div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-medium">Başlıq<input id="blog-title" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label><label class="text-sm font-medium">Slug<input id="blog-slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label><label class="text-sm font-medium sm:col-span-2">Tərcümə qrupu<input id="blog-translation-key" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" placeholder="Eyni məqalənin digər dillərində eyni dəyər" /></label><label class="text-sm font-medium sm:col-span-2">Qapaq şəkli<input id="blog-cover-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml" class="mt-1 block w-full text-sm" /><input id="blog-cover-image" type="url" class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" placeholder="və ya şəkil URL-i" /></label><label class="text-sm font-medium sm:col-span-2">Qısa məzmun<textarea id="blog-excerpt" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></textarea></label><label class="text-sm font-medium sm:col-span-2">Məzmun<textarea id="blog-content" required rows="8" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></textarea></label><label class="text-sm font-medium">SEO başlıq<input id="blog-seo-title" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label><label class="text-sm font-medium">SEO açıqlama<input id="blog-seo-description" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label></div>
      <label class="mt-4 flex items-center gap-2 text-sm"><input id="blog-published" type="checkbox" /> Dərc edilsin</label><div class="mt-6 flex justify-end gap-3"><button id="cancel-blog" type="button" class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-600">Ləğv et</button><button id="save-blog" type="submit" class="rounded-lg bg-[#FE7930] px-5 py-2 text-sm font-semibold text-white disabled:opacity-60">Yadda saxla</button></div>
    </form>
  </div>
</AdminLayout>

<script>
  type Blog = { id:number; title:string; slug:string; lang:'az'|'ru'|'en'; content:string; excerpt:string|null; coverImage:string|null; translationKey:string; seoTitle:string; seoDescription:string; isPublished:boolean };
  const initBlogs = () => {
    const form = document.getElementById('blog-form') as HTMLFormElement | null; if (!form || form.dataset.initialized) return; form.dataset.initialized = 'true';
    const modal = document.getElementById('blog-modal'); const table = document.getElementById('blogs-table'); const notice = document.getElementById('blog-notice'); const $ = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
    const fields = { id:$('blog-id') as HTMLInputElement,title:$('blog-title') as HTMLInputElement,slug:$('blog-slug') as HTMLInputElement,key:$('blog-translation-key') as HTMLInputElement,cover:$('blog-cover-image') as HTMLInputElement,file:$('blog-cover-file') as HTMLInputElement,excerpt:$('blog-excerpt') as HTMLTextAreaElement,content:$('blog-content') as HTMLTextAreaElement,seoTitle:$('blog-seo-title') as HTMLInputElement,seoDescription:$('blog-seo-description') as HTMLInputElement,published:$('blog-published') as HTMLInputElement,save:$('save-blog') as HTMLButtonElement };
    let blogs:Blog[]=[]; let lang:Blog['lang']='az'; let saving=false;
    const esc=(t:string)=>t.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]!)); const notify=(t:string,err=false)=>{if(!notice)return;notice.textContent=t;notice.className=`mb-4 rounded-lg px-4 py-3 text-sm ${err?'bg-red-50 text-red-700':'bg-emerald-50 text-emerald-700'}`};
    const render=()=>{if(!table)return;table.innerHTML=blogs.length?blogs.map(b=>`<tr class="border-b border-slate-100"><td class="px-5 py-4"><p class="font-semibold text-slate-900">${esc(b.title)}</p><p class="text-xs text-slate-400">${esc(b.slug)}</p></td><td class="px-5 py-4 uppercase">${b.lang}</td><td class="px-5 py-4">${b.isPublished?'<span class="text-emerald-600">Dərc olunub</span>':'<span class="text-amber-600">Qaralama</span>'}</td><td class="px-5 py-4 text-right"><button data-edit="${b.id}" class="mr-3 text-orange-600">Redaktə</button><button data-delete="${b.id}" class="text-red-600">Sil</button></td></tr>`).join(''):'<tr><td colspan="4" class="p-8 text-center text-slate-400">Hələ blog yoxdur.</td></tr>'};
    const load=async()=>{const r=await fetch('/api/blogs');if(!r.ok)throw new Error('Blogları yükləmək mümkün olmadı');blogs=await r.json();render()}; const fill=(b:Blog)=>{fields.id.value=String(b.id);fields.title.value=b.title;fields.slug.value=b.slug;fields.key.value=b.translationKey;fields.cover.value=b.coverImage??'';fields.excerpt.value=b.excerpt??'';fields.content.value=b.content;fields.seoTitle.value=b.seoTitle??'';fields.seoDescription.value=b.seoDescription??'';fields.published.checked=b.isPublished};
    const setTab=(next:Blog['lang'])=>{const current=blogs.find(b=>b.id===Number(fields.id.value));lang=next;document.querySelectorAll<HTMLButtonElement>('.lang-tab').forEach(t=>t.className=`lang-tab px-3 py-2 text-sm font-semibold ${t.dataset.lang===next?'border-b-2 border-orange-500 text-orange-600':'text-slate-500'}`);const translated=current&&(current.lang===next?current:blogs.find(b=>b.translationKey===current.translationKey&&b.lang===next));if(translated)fill(translated);else{const key=fields.key.value||fields.slug.value;form.reset();fields.id.value='';fields.key.value=key}};
    const open=(b?:Blog)=>{form.reset();fields.id.value='';lang=b?.lang??'az';if(b)fill(b);$('blog-modal-title').textContent=b?'Blogu redaktə et':'Yeni blog';setTab(lang);modal?.classList.replace('hidden','flex')}; const close=()=>modal?.classList.replace('flex','hidden');
    $('new-blog').addEventListener('click',()=>open());$('close-blog').addEventListener('click',close);$('cancel-blog').addEventListener('click',close);document.querySelectorAll<HTMLButtonElement>('.lang-tab').forEach(t=>t.addEventListener('click',()=>setTab(t.dataset.lang as Blog['lang'])));
    table?.addEventListener('click',async e=>{const b=(e.target as HTMLElement).closest<HTMLButtonElement>('button');if(!b)return;const edit=Number(b.dataset.edit),remove=Number(b.dataset.delete);if(edit)open(blogs.find(x=>x.id===edit));if(remove&&confirm('Bu blog silinsin?')){const r=await fetch(`/api/blogs/${remove}`,{method:'DELETE'});if(!r.ok)return notify('Blog silinə bilmədi.',true);await load();notify('Blog silindi.')}});
    form.addEventListener('submit',async e=>{e.preventDefault();if(saving||!form.reportValidity())return;saving=true;fields.save.disabled=true;fields.save.textContent='Yadda saxlanılır…';let key:string|undefined;try{let coverImage=fields.cover.value.trim(),file=fields.file.files?.[0];if(file){let fd=new FormData();fd.append('file',file);const r=await fetch('/api/upload',{method:'POST',body:fd}),u=await r.json();if(!r.ok||!u.url)throw new Error(u.error??'Şəkil yüklənmədi');coverImage=u.url;key=u.key}const data={title:fields.title.value,slug:fields.slug.value,translationKey:fields.key.value,lang,coverImage,excerpt:fields.excerpt.value,content:fields.content.value,seoTitle:fields.seoTitle.value,seoDescription:fields.seoDescription.value,isPublished:fields.published.checked},id=fields.id.value,r=await fetch(id?`/api/blogs/${id}`:'/api/blogs',{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}),result=await r.json();if(!r.ok)throw new Error(result.error??'Blog yadda saxlanmadı');await load();close();notify('Blog yadda saxlanıldı.')}catch(error){if(key)await fetch('/api/upload',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({key})}).catch(()=>undefined);notify(error instanceof Error?error.message:'Blog yadda saxlanmadı.',true)}finally{saving=false;fields.save.disabled=false;fields.save.textContent='Yadda saxla'}});load().catch(e=>notify(e instanceof Error?e.message:'Blogları yükləmək mümkün olmadı.',true));
  };initBlogs();document.addEventListener('astro:page-load',initBlogs);
</script>
