---
import AdminLayout from '../../layouts/AdminLayout.astro';
import getDb from '../../lib/db';

export const prerender = false;

// We will fetch blogs from the database here when schema is ready
const blogs = [];
---

<AdminLayout title="Blog İdarəetmə">
    <div class="mb-6 flex justify-between items-center">
        <h2 class="text-lg font-medium text-gray-800">Bütün Bloglar</h2>
        <button id="add-btn" class="bg-[#F0692A] hover:bg-orange-600 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm">
            + Yeni Blog
        </button>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Başlıq</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dil</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarix</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {blogs.length === 0 ? (
                        <tr>
                            <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-500">Heç bir blog tapılmadı.</td>
                        </tr>
                    ) : (
                        blogs.map((blog) => (
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{blog.title}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{blog.lang}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${blog.isPublished ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}`}>
                                        {blog.isPublished ? 'Aktiv' : 'Qaralama'}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{new Date(blog.createdAt).toLocaleDateString('az-AZ')}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <button class="text-indigo-600 hover:text-indigo-900 mr-3 edit-btn" data-id={blog.id}>Redaktə et</button>
                                    <button class="text-red-600 hover:text-red-900 delete-btn" data-id={blog.id}>Sil</button>
                                </td>
                            </tr>
                        ))
                    )}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for Add/Edit -->
    <div id="form-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" id="modal-backdrop"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
                <form id="blog-form" class="p-6">
                    <div class="flex justify-between items-center mb-5">
                        <h3 class="text-lg font-medium text-gray-900" id="modal-title">Yeni Blog</h3>
                        <button type="button" id="close-modal" class="text-gray-400 hover:text-gray-500">
                            <span class="sr-only">Bağla</span>
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    
                    <div class="space-y-4">
                        <input type="hidden" id="blog-id" name="id" />
                        
                        <div>
                            <label for="title" class="block text-sm font-medium text-gray-700">Başlıq</label>
                            <input type="text" name="title" id="title" required class="mt-1 focus:ring-[#F0692A] focus:border-[#F0692A] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md p-2 border" />
                        </div>
                        
                        <div>
                            <label for="slug" class="block text-sm font-medium text-gray-700">Slug</label>
                            <input type="text" name="slug" id="slug" required class="mt-1 focus:ring-[#F0692A] focus:border-[#F0692A] block w-full shadow-sm sm:text-sm border-gray-300 rounded-md p-2 border" />
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="lang" class="block text-sm font-medium text-gray-700">Dil</label>
                                <select id="lang" name="lang" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-[#F0692A] focus:border-[#F0692A] sm:text-sm">
                                    <option value="az">Azərbaycan (AZ)</option>
                                    <option value="en">English (EN)</option>
                                    <option value="ru">Русский (RU)</option>
                                </select>
                            </div>
                            
                            <div>
                                <label for="coverImage" class="block text-sm font-medium text-gray-700">Qapaq şəkli</label>
                                <input type="file" name="coverImage" id="coverImage" accept="image/*" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-[#F0692A] hover:file:bg-orange-100" />
                                <input type="hidden" name="coverImageUrl" id="coverImageUrl" />
                            </div>
                        </div>
                        
                        <div>
                            <label for="excerpt" class="block text-sm font-medium text-gray-700">Qısa Məzmun</label>
                            <textarea id="excerpt" name="excerpt" rows="2" class="mt-1 shadow-sm focus:ring-[#F0692A] focus:border-[#F0692A] block w-full sm:text-sm border border-gray-300 rounded-md p-2"></textarea>
                        </div>
                        
                        <div>
                            <label for="content" class="block text-sm font-medium text-gray-700">Məzmun</label>
                            <textarea id="content" name="content" rows="6" required class="mt-1 shadow-sm focus:ring-[#F0692A] focus:border-[#F0692A] block w-full sm:text-sm border border-gray-300 rounded-md p-2 font-mono text-sm"></textarea>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex items-center h-5">
                                <input id="isPublished" name="isPublished" type="checkbox" class="focus:ring-[#F0692A] h-4 w-4 text-[#F0692A] border-gray-300 rounded" checked>
                            </div>
                            <div class="ml-3 text-sm">
                                <label for="isPublished" class="font-medium text-gray-700">Dərc edilsin?</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-6 flex justify-end">
                        <button type="button" id="cancel-btn" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none mr-3">
                            Ləğv et
                        </button>
                        <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#F0692A] hover:bg-orange-600 focus:outline-none">
                            Yadda saxla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    // Client-side logic for modal and API calls
    const modal = document.getElementById('form-modal');
    const closeBtn = document.getElementById('close-modal');
    const cancelBtn = document.getElementById('cancel-btn');
    const addBtn = document.getElementById('add-btn');
    const backdrop = document.getElementById('modal-backdrop');
    const form = document.getElementById('blog-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title');
    
    function openModal(isEdit = false, data = null) {
        modal?.classList.remove('hidden');
        if (modalTitle) {
            modalTitle.textContent = isEdit ? 'Blogu Redaktə et' : 'Yeni Blog';
        }
        
        if (isEdit && data) {
            // Populate form
            const idInput = document.getElementById('blog-id') as HTMLInputElement;
            if(idInput) idInput.value = data.id || '';
            // Additional populating logic here
        } else {
            form?.reset();
            const idInput = document.getElementById('blog-id') as HTMLInputElement;
            if(idInput) idInput.value = '';
        }
    }
    
    function closeModal() {
        modal?.classList.add('hidden');
        form?.reset();
    }
    
    addBtn?.addEventListener('click', () => openModal(false));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    
    // Auto-generate slug from title
    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    
    titleInput?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (slugInput && !document.getElementById('blog-id')?.getAttribute('value')) {
            slugInput.value = val.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
        }
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const fileInput = document.getElementById('coverImage') as HTMLInputElement;
        
        // Handle file upload first if present
        if (fileInput?.files && fileInput.files[0]) {
            const uploadData = new FormData();
            uploadData.append('file', fileInput.files[0]);
            
            try {
                const uploadRes = await fetch('/api/upload', {
                    method: 'POST',
                    body: uploadData
                });
                
                if (uploadRes.ok) {
                    const { url } = await uploadRes.json();
                    formData.set('coverImageUrl', url);
                }
            } catch (err) {
                console.error("Upload failed", err);
                alert("Şəkil yüklənərkən xəta baş verdi");
                return;
            }
        }
        
        const data = Object.fromEntries(formData.entries());
        data.isPublished = formData.has('isPublished') ? 'true' : 'false';
        
        const isEdit = !!data.id;
        const url = isEdit ? `/api/blogs/${data.id}` : '/api/blogs';
        const method = isEdit ? 'PUT' : 'POST';
        
        try {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            
            if (res.ok) {
                window.location.reload();
            } else {
                alert('Xəta baş verdi. Zəhmət olmasa yenidən cəhd edin.');
            }
        } catch (err) {
            console.error(err);
            alert('Xəta baş verdi.');
        }
    });

    // Delete actions
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const id = (e.target as HTMLButtonElement).getAttribute('data-id');
            if (confirm('Bu blogu silmək istədiyinizə əminsiniz?')) {
                try {
                    const res = await fetch(`/api/blogs/${id}`, { method: 'DELETE' });
                    if (res.ok) window.location.reload();
                    else alert('Silinmə zamanı xəta baş verdi');
                } catch (err) {
                    console.error(err);
                }
            }
        });
    });
</script>
