---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Əlaqə mesajları">
  <div>
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">Əlaqə mesajları</h1>
      <p class="text-sm text-slate-500 mt-1">Sayt üzərindən göndərilən bütün müraciətlər</p>
    </div>
    <div id="messages-list" class="bg-white rounded-2xl border border-slate-200 overflow-hidden divide-y divide-slate-100"></div>
    <div id="empty-messages" class="hidden text-center py-20 text-slate-400 border border-dashed border-slate-200 rounded-2xl">
      Hələ heç bir mesaj yoxdur
    </div>
  </div>

  <div id="message-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg p-6 sm:p-8 max-h-[85vh] overflow-y-auto">
      <div class="flex items-start justify-between mb-6">
        <div><h2 id="modal-name" class="text-lg font-bold text-slate-900"></h2><p id="modal-subject" class="text-sm text-slate-500 mt-0.5"></p></div>
        <button type="button" id="close-modal" class="text-slate-400 hover:text-slate-700 cursor-pointer border-none bg-transparent text-xl" aria-label="Bağla">✕</button>
      </div>
      <div class="space-y-4 text-sm">
        <div class="flex items-center gap-2 text-slate-500"><span>☎</span><span id="modal-phone" class="font-medium text-slate-700"></span><span id="modal-email"></span></div>
        <div class="text-slate-400 text-xs" id="modal-date"></div>
        <div class="bg-slate-50 rounded-xl p-4"><p id="modal-message" class="text-slate-700 leading-relaxed whitespace-pre-wrap"></p></div>
        <div><label class="block text-sm font-medium text-slate-700 mb-1.5">Cavab yazın</label><textarea id="reply-text" rows="4" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm resize-none" placeholder="Cavabınızı bura yazın..."></textarea></div>
        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" id="mark-read-btn" class="px-5 py-2.5 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 border-none bg-transparent cursor-pointer">Oxunmuş et</button>
          <button type="button" id="send-reply-btn" class="px-6 py-2.5 rounded-lg text-sm font-semibold text-white bg-[#ff5a24] hover:bg-[#e94d1b] border-none cursor-pointer">Cavab göndər</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import {
    deleteContact,
    getContacts,
    markContactAsRead,
    replyToContact,
    type Contact,
  } from '../../services/contacts-admin.service';

  const initContactAdmin = () => {
    const list = document.getElementById('messages-list');
    const empty = document.getElementById('empty-messages');
    const modal = document.getElementById('message-modal');
    const replyText = document.getElementById('reply-text') as HTMLTextAreaElement | null;
    if (!list || !empty || !modal) return;

    let contacts: Contact[] = [];
    let active: Contact | null = null;
    const labels = { new: ['Yeni', 'bg-[#ff5a24] text-white'], read: ['Oxunub', 'bg-slate-100 text-slate-500'], replied: ['Cavablandırılıb', 'bg-green-50 text-green-600'] };
    const showError = (message: string, error?: unknown) => {
      if (error) console.error(error);
      list.innerHTML = `<p class="p-5 text-red-500">${message}</p>`;
    };
    const showAlert = (message: string, error: unknown) => {
      console.error(error);
      alert(message);
    };
    const escape = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char] ?? char));
    const render = () => {
      empty.classList.toggle('hidden', contacts.length > 0);
      list.innerHTML = contacts.map((item) => `<div data-id="${item.id}" class="message-row flex items-start gap-4 p-5 hover:bg-slate-50 cursor-pointer">
        <div class="w-10 h-10 rounded-full bg-orange-50 text-[#ff5a24] flex items-center justify-center font-bold text-sm">${escape(item.name.charAt(0))}</div>
        <div class="flex-1 min-w-0"><div class="flex items-center gap-2 mb-1"><p class="font-semibold text-slate-900 truncate">${escape(item.name)}</p><span class="status-badge inline-block rounded-full text-[10px] font-bold px-2.5 py-0.5 ${labels[item.status][1]}">${labels[item.status][0]}</span></div><p class="text-sm font-medium text-slate-700 truncate">${escape(item.subject)}</p><p class="text-sm text-slate-500 truncate mt-0.5">${escape(item.message)}</p></div>
        <div class="flex flex-col items-end gap-2"><span class="text-xs text-slate-400">${new Date(item.createdAt).toLocaleString()}</span><button type="button" class="delete-msg-btn text-slate-400 hover:text-red-500 p-1.5 border-none bg-transparent" aria-label="Sil">🗑</button></div>
      </div>`).join('');
      list.querySelectorAll<HTMLElement>('.message-row').forEach((row) => row.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('.delete-msg-btn')) return;
        void openModal(Number(row.dataset.id));
      }));
      list.querySelectorAll<HTMLElement>('.delete-msg-btn').forEach((button) => button.addEventListener('click', async (event) => {
        event.stopPropagation();
        const id = Number((button.closest('.message-row') as HTMLElement).dataset.id);
        if (!confirm('Bu mesaj silinsin?')) return;
        try {
          await deleteContact(id);
          contacts = contacts.filter((item) => item.id !== id);
          render();
        } catch (error) {
          showAlert('Mesaj silinə bilmədi, yenidən cəhd edin.', error);
        }
      }));
    };
    const openModal = async (id: number) => {
      active = contacts.find((item) => item.id === id) ?? null;
      if (!active) return;
      try {
        if (active.status === 'new') {
          await markContactAsRead(id);
          active.status = 'read';
          render();
        }
        document.getElementById('modal-name')!.textContent = active.name;
        document.getElementById('modal-subject')!.textContent = active.subject;
        document.getElementById('modal-phone')!.textContent = active.phone;
        document.getElementById('modal-email')!.textContent = active.email;
        document.getElementById('modal-date')!.textContent = new Date(active.createdAt).toLocaleString();
        document.getElementById('modal-message')!.textContent = active.message;
        if (replyText) replyText.value = '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      } catch (error) {
        showAlert('Mesaj açıla bilmədi, yenidən cəhd edin.', error);
      }
    };
    const closeModal = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); active = null; };
    document.getElementById('close-modal')?.addEventListener('click', closeModal);
    document.getElementById('mark-read-btn')?.addEventListener('click', async () => {
      if (!active) return;
      try {
        await markContactAsRead(active.id);
        active.status = 'read';
        render();
        closeModal();
      } catch (error) {
        showAlert('Status dəyişdirilə bilmədi, yenidən cəhd edin.', error);
      }
    });
    // poslat
    document.getElementById('send-reply-btn')?.addEventListener('click', async () => {
      if (!active || !replyText?.value.trim()) return;
      try {
        const result = await replyToContact(active.id, replyText.value.trim());
        active.status = 'replied';
        render();
        closeModal();
        window.location.href = result.mailto;
      } catch (error) {
        showAlert('Cavab göndərilə bilmədi, yenidən cəhd edin.', error);
      }
    });
    void getContacts()
      .then((response) => {
        contacts = response.data;
        render();
      })
      .catch((error) => showError('Mesajları yükləmək mümkün olmadı.', error));
  };

  document.addEventListener('astro:page-load', initContactAdmin);
  initContactAdmin();
</script>
