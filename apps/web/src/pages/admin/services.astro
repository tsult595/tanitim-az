---
// src/pages/admin/servicesAdmin.astro
import AdminLayout from '../../layouts/AdminLayout.astro';

---

<AdminLayout title="Xidmətlər">
  <div>
    <!-- Заголовок + кнопка добавить -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Xidmətlər</h1>
        <p class="text-sm text-slate-500 mt-1">Bütün xidmət kartlarını idarə edin</p>
      </div>

      <button
        type="button"
        id="open-add-modal"
        class="inline-flex items-center gap-2 bg-[#FE7930] hover:bg-orange-600 transition-colors text-white text-sm font-semibold px-5 py-2.5 rounded-lg cursor-pointer border-none"
      >
        <span class="text-lg leading-none">+</span>
        Yeni Xidmət
      </button>
    </div>

    <!-- Таблица сервисов -->
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-4 font-medium">Şəkil</th>
            <th class="px-6 py-4 font-medium">Başlıq</th>
            <th class="px-6 py-4 font-medium">İkon</th>
            <th class="px-6 py-4 font-medium">Variant</th>
            <th class="px-6 py-4 font-medium text-right">Əməliyyatlar</th>
          </tr>
        </thead>
        <tbody id="services-table-body" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
  </div>

  <!-- Модалка добавления/редактирования -->
  <div
    id="service-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm p-4"
  >
    <div class="bg-white rounded-2xl w-full max-w-lg p-6 sm:p-8">
      <div class="flex items-center justify-between mb-6">
        <h2 id="modal-title" class="text-lg font-bold text-slate-900">Yeni Xidmət</h2>
        <button
          type="button"
          id="close-modal"
          class="text-slate-400 hover:text-slate-700 cursor-pointer border-none bg-transparent text-xl leading-none"
          aria-label="Bağla"
        >
          ✕
        </button>
      </div>

      <form id="service-form" class="flex flex-col gap-4">
        <input type="hidden" id="service-id" />

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Başlıq</label>
          <input
            type="text"
            id="service-title"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FE7930]/40 focus:border-[#FE7930]"
            placeholder="Xidmətin adı"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Variant (rəng)</label>
          <select
            id="service-variant"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FE7930]/40 focus:border-[#FE7930] bg-white"
          >
            <option value="gray">Gray</option>
            <option value="peach">Peach</option>
            <option value="orange">Orange</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Şəkil (URL)</label>
          <input
            type="text"
            id="service-img"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#FE7930]/40 focus:border-[#FE7930]"
            placeholder="/aboutUs/example.png"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">İkon (SVG kodu)</label>
          <textarea
            id="service-icon"
            rows="3"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-[#FE7930]/40 focus:border-[#FE7930] resize-none"
            placeholder="<svg>...</svg>"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 mt-4">
          <button
            type="button"
            id="cancel-modal"
            class="px-5 py-2.5 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer border-none bg-transparent"
          >
            Ləğv et
          </button>
          <button
            type="submit"
            class="px-6 py-2.5 rounded-lg text-sm font-semibold text-white bg-[#FE7930] hover:bg-orange-600 transition-colors cursor-pointer border-none"
          >
            Yadda saxla
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  function initServicesAdmin() {
    const modal = document.getElementById('service-modal');
    const openBtn = document.getElementById('open-add-modal');
    const closeBtn = document.getElementById('close-modal');
    const cancelBtn = document.getElementById('cancel-modal');
    const modalTitle = document.getElementById('modal-title');
    const form = document.getElementById('service-form') as HTMLFormElement | null;

    const idInput = document.getElementById('service-id') as HTMLInputElement | null;
    const titleInput = document.getElementById('service-title') as HTMLInputElement | null;
    const variantInput = document.getElementById('service-variant') as HTMLSelectElement | null;
    const imgInput = document.getElementById('service-img') as HTMLInputElement | null;
    const iconInput = document.getElementById('service-icon') as HTMLTextAreaElement | null;
    const tableBody = document.getElementById('services-table-body');

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
      }[character] ?? character));

    const renderServices = (items: Array<Record<string, unknown>>) => {
      if (!tableBody) return;
      tableBody.innerHTML = items.map((service) => {
        const id = Number(service.id);
        const title = String(service.title ?? '');
        const variant = String(service.variant ?? 'gray');
        const imageUrl = String(service.imageUrl ?? '');
        const icon = String(service.icon ?? '');
        return `<tr data-service-id="${id}" data-icon="${escapeHtml(icon)}" class="hover:bg-slate-50 transition-colors">
          <td class="px-6 py-4"><img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(title)}" class="w-14 h-14 rounded-lg object-cover bg-slate-50" /></td>
          <td class="px-6 py-4"><p class="font-semibold text-slate-900 service-title">${escapeHtml(title)}</p></td>
          <td class="px-6 py-4"><div class="w-9 h-9 rounded-lg flex items-center justify-center">${icon}</div></td>
          <td class="px-6 py-4"><span class="inline-block rounded-full text-xs font-bold px-3 py-1 service-variant" data-value="${escapeHtml(variant)}">${escapeHtml(variant)}</span></td>
          <td class="px-6 py-4"><div class="flex items-center justify-end gap-2">
            <button type="button" class="edit-btn text-slate-500 hover:text-[#FE7930] p-2 rounded-lg cursor-pointer border-none bg-transparent" aria-label="Redaktə et">Edit</button>
            <button type="button" class="delete-btn text-slate-500 hover:text-red-500 p-2 rounded-lg cursor-pointer border-none bg-transparent" aria-label="Sil">Delete</button>
          </div></td>
        </tr>`;
      }).join('');
    };

    const loadServices = async () => {
      const response = await fetch('/api/services?lang=az');
      if (!response.ok) throw new Error('Xidmətləri yükləmək mümkün olmadı');
      renderServices(await response.json());
    };

    const openModal = (mode: 'add' | 'edit', row?: HTMLElement) => {
      if (!modal || !modalTitle) return;

      if (mode === 'add') {
        modalTitle.textContent = 'Yeni Xidmət';
        form?.reset();
        if (idInput) idInput.value = '';
      } else if (row) {
        modalTitle.textContent = 'Xidməti Redaktə Et';

        const title = row.querySelector('.service-title')?.textContent ?? '';
        const variant = row.querySelector('.service-variant')?.getAttribute('data-value') ?? 'gray';
        const img = row.querySelector('img')?.getAttribute('src') ?? '';
        const icon = row.dataset.icon ?? '';

        if (idInput) idInput.value = row.dataset.serviceId ?? '';
        if (titleInput) titleInput.value = title;
        if (variantInput) variantInput.value = variant;
        if (imgInput) imgInput.value = img;
        if (iconInput) iconInput.value = icon;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };

    const closeModal = () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    };

    openBtn?.addEventListener('click', () => openModal('add'));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    tableBody?.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const row = target.closest('tr');
      if (!row) return;

      if (target.closest('.edit-btn')) {
        openModal('edit', row);
        return;
      }

      if (target.closest('.delete-btn')) {
        const title = row.querySelector('.service-title')?.textContent ?? 'bu xidməti';
        if (!confirm(`"${title}" silinsin?`)) return;
        const response = await fetch(`/api/services/${row.dataset.serviceId}`, { method: 'DELETE' });
        if (!response.ok) throw new Error('Xidməti silmək mümkün olmadı');
        await loadServices();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        title: titleInput?.value,
        variant: variantInput?.value,
        imageUrl: imgInput?.value,
        icon: iconInput?.value,
      };

      const id = idInput?.value;
      const response = await fetch(id ? `/api/services/${id}` : '/api/services', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!response.ok) {
        const result = await response.json().catch(() => ({}));
        throw new Error(result.error ?? 'Xidməti saxlamaq mümkün olmadı');
      }
      await loadServices();
      closeModal();
    });

    loadServices().catch((error) => {
      console.error(error);
      if (tableBody) tableBody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-red-500">${error.message}</td></tr>`;
    });
  }

  initServicesAdmin();
  document.addEventListener('astro:page-load', initServicesAdmin);
</script>