---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb, schema } from '../../lib/db';
import { asc } from 'drizzle-orm';

export const prerender = false;

const services = await getDb(env.DB)
  .select()
  .from(schema.services)
  .orderBy(asc(schema.services.sortOrder), asc(schema.services.id));
---

<AdminLayout title="Xidmətlər">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Xidmətlər</h1>
      <p class="text-sm text-slate-500 mt-1">Xidmətləri əlavə edin, dəyişin və silin</p>
    </div>
    <button id="open-add-modal" type="button" class="rounded-lg bg-[#FE7930] px-5 py-2.5 text-sm font-semibold text-white">+ Yeni Xidmət</button>
  </div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-slate-500">
        <tr>
          <th class="px-6 py-4">Şəkil</th>
          <th class="px-6 py-4">Başlıq</th>
          <th class="px-6 py-4">Variant</th>
          <th class="px-6 py-4 text-right">Əməliyyatlar</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {services.map((service) => (
          <tr data-service={JSON.stringify(service)} class="hover:bg-slate-50">
            <td class="px-6 py-4">
              <img src={service.imageUrl} alt={service.title} class="h-14 w-14 rounded-lg object-cover" />
            </td>
            <td class="px-6 py-4 font-semibold text-slate-900">{service.title}</td>
            <td class="px-6 py-4 text-slate-500">{service.variant}</td>
            <td class="px-6 py-4 text-right">
              <button type="button" class="edit-btn mr-3 text-[#FE7930]">Redaktə</button>
              <button type="button" class="delete-btn text-red-500">Sil</button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    {services.length === 0 && <p class="p-12 text-center text-slate-400">Hələ xidmət yoxdur.</p>}
  </div>

  <div id="service-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
    <form id="service-form" class="w-full max-w-lg rounded-2xl bg-white p-6">
      <div class="mb-5 flex items-center justify-between">
        <h2 id="modal-title" class="text-lg font-bold">Yeni Xidmət</h2>
        <button id="close-modal" type="button" class="text-xl">×</button>
      </div>
      <input id="service-id" type="hidden" />
      <label class="mb-1 block text-sm font-medium">Başlıq</label>
      <input id="service-title" required class="mb-4 w-full rounded-lg border p-2.5" />
      <label class="mb-1 block text-sm font-medium">Şəkil URL-i</label>
      <input id="service-image" required class="mb-4 w-full rounded-lg border p-2.5" placeholder="/api/r2/aboutUs/btl.png" />
      <label class="mb-1 block text-sm font-medium">Variant</label>
      <select id="service-variant" class="mb-4 w-full rounded-lg border bg-white p-2.5">
        <option value="gray">Gray</option>
        <option value="peach">Peach</option>
        <option value="orange">Orange</option>
      </select>
      <label class="mb-1 block text-sm font-medium">İkon (SVG)</label>
      <textarea id="service-icon" rows="4" class="mb-6 w-full rounded-lg border p-2.5 font-mono text-xs"></textarea>
      <div class="flex justify-end gap-3">
        <button id="cancel-modal" type="button" class="rounded-lg px-4 py-2 text-slate-600">Ləğv et</button>
        <button type="submit" class="rounded-lg bg-[#FE7930] px-5 py-2 font-semibold text-white">Yadda saxla</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const initServicesAdmin = () => {
    const modal = document.querySelector('#service-modal');
    const form = document.querySelector('#service-form') as HTMLFormElement | null;
    const idInput = document.querySelector('#service-id') as HTMLInputElement | null;
    const titleInput = document.querySelector('#service-title') as HTMLInputElement | null;
    const imageInput = document.querySelector('#service-image') as HTMLInputElement | null;
    const variantInput = document.querySelector('#service-variant') as HTMLSelectElement | null;
    const iconInput = document.querySelector('#service-icon') as HTMLTextAreaElement | null;
    const close = () => { modal?.classList.add('hidden'); modal?.classList.remove('flex'); };
    const open = (service?: any) => {
      if (service) {
        idInput!.value = service.id;
        titleInput!.value = service.title;
        imageInput!.value = service.imageUrl ?? '';
        variantInput!.value = service.variant ?? 'gray';
        iconInput!.value = service.icon ?? '';
        document.querySelector('#modal-title')!.textContent = 'Xidməti Redaktə Et';
      } else {
        form?.reset();
        idInput!.value = '';
        document.querySelector('#modal-title')!.textContent = 'Yeni Xidmət';
      }
      modal?.classList.remove('hidden'); modal?.classList.add('flex');
    };

    document.querySelector('#open-add-modal')?.addEventListener('click', () => open());
    document.querySelector('#close-modal')?.addEventListener('click', close);
    document.querySelector('#cancel-modal')?.addEventListener('click', close);
    document.querySelectorAll('.edit-btn').forEach((button) => button.addEventListener('click', () => {
      open(JSON.parse((button.closest('tr') as HTMLElement).dataset.service!));
    }));
    document.querySelectorAll('.delete-btn').forEach((button) => button.addEventListener('click', async () => {
      const row = button.closest('tr') as HTMLElement;
      const service = JSON.parse(row.dataset.service!);
      if (!confirm(`"${service.title}" silinsin?`)) return;
      const response = await fetch(`/api/services/${service.id}`, { method: 'DELETE' });
      if (!response.ok) throw new Error('Service deletion failed');
      location.reload();
    }));
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const id = idInput?.value;
      const payload = {
        title: titleInput?.value,
        imageUrl: imageInput?.value,
        variant: variantInput?.value,
        icon: iconInput?.value,
        sortOrder: 0,
        isActive: true,
        lang: 'az',
      };
      const response = await fetch(id ? `/api/services/${id}` : '/api/services', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error('Service save failed');
      location.reload();
    });
  };
  initServicesAdmin();
  document.addEventListener('astro:page-load', initServicesAdmin);
</script>
