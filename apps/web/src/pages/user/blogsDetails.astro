---
import UserLayout from '../../layouts/UserLayout.astro';

interface Props {
  title?: string;
  categoryTags?: string[];
  coverImage?: string;
}

const { 
  title = "Kreativ Strategiyanın Brend İnkişafında Rolu", 
  categoryTags = ["Brendinq", "Strategiya"],
  coverImage = "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1000" 
} = Astro.props;

// Левое навигационное меню
const topics = [
  { label: "All Posts", icon: "layout-grid", active: false },
  { label: "Design Trends", icon: "pen-tool", active: true },
  { label: "Brand Strategy", icon: "lightbulb", active: false },
  { label: "Case Studies", icon: "file-text", active: false },
  { label: "Culture", icon: "users", active: false },
];

// Похожие и последние статьи для правого сайдбара
const relatedArticles = [
  {
    title: "Minimalizm: Dizaynda Az...",
    date: "12 Oktyabr, 2023",
    image: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=200"
  },
  {
    title: "UI/UX Trendləri...",
    date: "5 Noyabr, 2023",
    image: "https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?q=80&w=200"
  }
];
---

<UserLayout>
  <section class="py-25 bg-[#FAFAFA] min-h-screen">
    <div class="mx-auto max-w-298 px-4 sm:px-6 lg:px-0 flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- 1. Левый Сайдбар: Topics (Навигация) -->
      <aside class="w-full lg:w-1/5 shrink-0 pt-2">
        <div class="mb-6">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Topics</h3>
          <p class="text-xs text-gray-400 mt-0.5">Explore insights</p>
        </div>

      <nav class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-1">
  {topics.map((item) => (
    <a
      href="#"
      class:list={[
        "flex min-w-0 items-center gap-3 rounded-xl px-2 py-2.5 text-sm font-medium transition-all duration-200",
        item.active
          ? "bg-orange-50/50 font-semibold text-[#D96B27]"
          : "text-gray-600 hover:bg-gray-100/60 hover:text-gray-900",
      ]}
    >
      {item.icon === "layout-grid" && (
        <svg
          class="h-4 w-4 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
          />
        </svg>
      )}

      <span class="truncate">{item.label}</span>
    </a>
  ))}
</nav>
      </aside>

      <!-- 2. Центральная Белая Карточка статьи -->
      <main class="w-full lg:w-3/5 bg-white rounded-3xl p-6 sm:p-10 shadow-sm">
        
        <!-- Теги категорий -->
        <div class="flex items-center gap-2 mb-6">
          {categoryTags.map((tag) => (
            <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
              {tag}
            </span>
          ))}
        </div>

        <!-- Заголовок -->
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight tracking-tight mb-8">
          {title}
        </h1>

        <!-- Выделенный блок цитаты с оранжевой полосой -->
        <div class="border-l-2 border-[#D96B27] pl-4 py-1 mb-8">
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-medium">
            Düzgün qurulmuş kreativ strategiya yalnız estetik deyil, həm də biznes hədəflərinə çatmaq üçün güclü bir alətdir.
          </p>
        </div>

        <!-- Обложка статьи -->
        <div class="w-full h-64 sm:h-80 overflow-hidden rounded-2xl mb-8 bg-gray-100">
          <img 
            src={coverImage} 
            alt={title} 
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Основной текст статьи -->
        <div class="space-y-6 text-gray-600 text-sm sm:text-base leading-relaxed">
          <p>
            Günümüzün rəqabətli bazarında sadəcə yaxşı məhsul və ya xidmət təklif etmək kifayət deyil. İstehlakçılar markalarla emosional bağ qurmaq, onların dəyərlərini anlamaq istəyirlər. Məhz burada kreativ strategiya dövrəyə girir.
          </p>

          <h2 class="text-xl font-bold text-gray-900 pt-2">
            Kreativ Strategiya Nədir?
          </h2>

          <p>
            Kreativ strategiya, markanın mesajını hədəf kütləyə ən təsirli, yaddaqalan və orijinal yolla çatdırmaq üçün hazırlanmış uzunmüddətli plandır. Bu, yalnız vizual dizayn (loqo, rənglər) deyil, həm də ton, səs və hekayəanlatma elementlərini özündə birləşdirir.
          </p>
        </div>
      </main>

      <!-- 3. Правый Сайдбар: Похожие и последние статьи -->
      <aside class="w-full lg:w-1/4 shrink-0 space-y-6">
        
        <!-- Блок "Digər Məqalələr" -->
        <div class="bg-white rounded-3xl p-6 shadow-sm">
          <h3 class="text-lg font-bold text-gray-900 mb-5">Digər Məqalələr</h3>
          <div class="space-y-4">
            {relatedArticles.map((article) => (
              <a href="#" class="flex items-center gap-3 group">
                <img 
                  src={article.image} 
                  alt={article.title} 
                  class="w-14 h-14 rounded-xl object-cover shrink-0"
                />
                <div>
                  <h4 class="text-xs font-bold text-gray-900 group-hover:text-[#D96B27] transition-colors line-clamp-2">
                    {article.title}
                  </h4>
                  <p class="text-[11px] text-gray-400 mt-1">{article.date}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Блок "Son Yayımlananlar" -->
        <div class="bg-white rounded-3xl p-6 shadow-sm">
          <h3 class="text-lg font-bold text-gray-900 mb-5">Son Yayımlananlar</h3>
          <div class="space-y-4">
            {relatedArticles.map((article) => (
              <a href="#" class="flex items-center gap-3 group">
                <img 
                  src={article.image} 
                  alt={article.title} 
                  class="w-14 h-14 rounded-xl object-cover shrink-0"
                />
                <div>
                  <h4 class="text-xs font-bold text-gray-900 group-hover:text-[#D96B27] transition-colors line-clamp-2">
                    {article.title}
                  </h4>
                  <p class="text-[11px] text-gray-400 mt-1">{article.date}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

      </aside>

    </div>
  </section>
</UserLayout>