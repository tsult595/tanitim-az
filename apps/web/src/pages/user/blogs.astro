---
import { and, desc, eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb, schema } from '../../lib/db';
import UserLayout from '../../layouts/UserLayout.astro';
import BlogCard from '../../components/user/BlogCard.astro';
import BlogsFooter from '../../components/user/BlogsFooter.astro';
export const prerender = false;
const lang = ['az', 'ru', 'en'].includes(Astro.url.searchParams.get('lang') ?? '') ? Astro.url.searchParams.get('lang')! : 'az';
const db = env.DB ? getDb(env.DB) : null;
const localizedPosts = db ? await db.select().from(schema.blogs).where(and(eq(schema.blogs.isPublished, true), eq(schema.blogs.lang, lang))).orderBy(desc(schema.blogs.publishedAt)) : [];
// Until a translation is published, show the AZ version rather than an empty blog page.
const posts = localizedPosts.length || lang === 'az' || !db
  ? localizedPosts
  : await db.select().from(schema.blogs).where(and(eq(schema.blogs.isPublished, true), eq(schema.blogs.lang, 'az'))).orderBy(desc(schema.blogs.publishedAt));
---
<UserLayout title="Blog — Tanitim.az">
  <section class="mt-10 min-h-screen py-12 sm:py-16"><div class="mx-auto max-w-7xl px-4 sm:px-8"><h1 class="text-5xl font-black text-[#FE7930]">BLOGLAR</h1><p class="mt-4 max-w-xl text-lg text-gray-500">Rəqəmsal transformasiya, dizayn trendləri və agentlik həyatı barədə ən son fikirlərimiz.</p>
  {posts.length ? <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <BlogCard image={post.coverImage || '/tanitim_logo.png'} title={post.title} description={post.excerpt || post.content.slice(0, 180)} category={post.lang.toUpperCase()} href={`/user/blogs/${post.slug}?lang=${lang}`} />)}</div> : <p data-i18n="blog.empty" class="mt-12 rounded-2xl border border-dashed border-slate-200 p-10 text-center text-slate-500">Hələ dərc olunmuş blog yoxdur.</p>}</div><BlogsFooter /></section>
</UserLayout>
