  image?: string;
  category?: string;
  date?: string;
  title?: string;
  description?: string;
  href?: string;
}

const blogs: BlogCardProps[] = [
  {
  image : "/img.jpeg",
  category : "DESIGN",
  date : "5 Dəqİqə",
  title : "The Rise of Organic UI Elements",
  description : "Müasir interfeyslərin təbii formalarını və axıcı hərəkətlərini necə istifadə etdiyini öyrənin.",
  href : "/blog"
},
  {
  image : "/img.jpeg",
  category : "DESIGN",
  date : "5 Dəqİqə",
  title : "The Rise of Organic UI Elements",
  description : "Müasir interfeyslərin təbii formalarını və axıcı hərəkətlərini necə istifadə etdiyini öyrənin.",
  href : "/blog"
},
  {
  image : "/img.jpeg",
  category : "DESIGN",
  date : "5 Dəqİqə",
  title : "The Rise of Organic UI Elements",
  description : "Müasir interfeyslərin təbii formalarını və axıcı hərəkətlərini necə istifadə etdiyini öyrənin.",
  href : "/blog"
},
];


interface Product {
  title: string;
  description: string;
  href?: string;
  imgSrc: string;
}

const products: Product[] = [
  {
    title: "The Future of Digital Transformation in 2024",
    description:
      "Rəqəmsal transformasiya, dizayn trendləri və agentlik həyatı barədə ən son fikirlərimiz.",
    href: "https://influencer.az",
    imgSrc: "/img.jpeg",
  },
  {
    title: "UTM.AZ",
    description:
      "Kampaniyalarınızın effektivliyini ölçmək üçün mükəmməl analitika aləti. Linklərinizi qısaldın, izləyin və auditoriyanızı daha yaxşı anlayın.",
    href: "https://utm.az",
    imgSrc: "/test.png",
  },
];
---

<UserLayout title="Блог — Tanitim.az">
  <section class="py-12 mt-10 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-0">

      <!-- Заголовок страницы -->
      <h1 class="text-5xl sm:text-7xl font-black text-[#FE7930]">
        BLOGLAR
      </h1>

      <p class="mt-4 max-w-xl text-gray-500 text-lg">
        Rəqəmsal transformasiya, dizayn trendləri və agentlik həyatı barədə ən son fikirlərimiz.
      </p>

      <!-- Главный слайдер -->
      <div class="relative mt-12 overflow-hidden rounded-2xl h-[600px] shadow-2xl">
        {
          products.map((product, index) => (
            <div 
              data-slide={index}
              class:list={[
                "absolute inset-0 transition-opacity duration-500 ease-in-out",
                index === 0 ? "opacity-100 z-10" : "opacity-0 z-0 pointer-events-none"
              ]}
            >
              <img
                src={product.imgSrc}
                alt={product.title}
                class="h-full w-full object-cover"
              />

              <!-- Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

              <!-- Content -->
              <div class="absolute bottom-12 left-6 sm:left-12 text-white max-w-2xl">
                <div class="flex items-center gap-2 mb-6">
                  <span class="rounded-full bg-white/20 backdrop-blur-md px-4 py-1 text-xs font-bold tracking-wider">
                    STRATEGY
                  </span>
                  <span class="text-sm opacity-90">⏱ 6 min</span>
                </div>

                <h2 class="text-4xl sm:text-6xl font-bold leading-tight">
                  {product.title}
                </h2>

                <p class="mt-4 text-lg sm:text-xl opacity-90 leading-relaxed">
                  {product.description}
                </p>

                <a
                  href="/user/blogsDetails"
                  rel="noopener noreferrer"
                  class="mt-8 inline-flex items-center gap-3 text-sm font-bold uppercase tracking-widest hover:text-[#FE7930] transition-colors"
                >
                  DAHA ÇOX OXU
                  <span class="text-base">→</span>
                </a>
              </div>
            </div>
          ))
        }

        <!-- Индикаторы (линии переключения) -->
        <div class="absolute bottom-8 right-8 z-20 flex gap-3">
          {
            products.map((_, index) => (
              <button
                data-dot={index}
                aria-label={`Go to slide ${index + 1}`}
                class:list={[
                  "h-1.5 transition-all duration-300 cursor-pointer",
                  index === 0 ? "w-10 bg-white" : "w-6 bg-white/40 hover:bg-white/70"
                ]}
              ></button>
            ))
          }
        </div>
      </div>

      <!-- Сетка остальных карточек блога -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
  {
    blogs.map((blog) => (
      <BlogCard {...blog} />
    ))
  }
</div>

    </div>
  </section>
</UserLayout>

<!-- Скрипт переключения слайдов -->
<script>
  function initCarousel() {
    const slides = document.querySelectorAll('[data-slide]');
    const dots = document.querySelectorAll('[data-dot]');

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIndex = Number(dot.getAttribute('data-dot'));

        slides.forEach((slide, idx) => {
          if (idx === targetIndex) {
            slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            slide.classList.add('opacity-100', 'z-10');
          } else {
            slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
            slide.classList.remove('opacity-100', 'z-10');
          }
        });

        dots.forEach((d, idx) => {
          if (idx === targetIndex) {
            d.classList.add('w-10', 'bg-white');
            d.classList.remove('w-6', 'bg-white/40');
          } else {
            d.classList.remove('w-10', 'bg-white');
            d.classList.add('w-6', 'bg-white/40');
          }
        });
      });
    });
  }

  // Запуск при загрузке страницы и при переходах View Transitions
  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>