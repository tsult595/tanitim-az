---
import UserLayout from '../layouts/UserLayout.astro';

const messages = [
  'Bəzi görüşlərə hazırlaşmaq vaxt aparır. Biz də sizinlə görüşə hazırlaşırıq. ❤️',
  'Sizi gözlətmək istəməzdik... Amma saytımızın öz planları var. 🛠️',
  'Sevgi səbir tələb edir. Yaxşı sayt da. ❤️🛠️',
  'Getməyin... Sadəcə saytımızın saçını düzəldirik. 😭',
  'Gecikdik, üzr istəyirik. Amma gözəl şeylər bir az gec gəlir. 😉',
  '🚧 Burada sayt olmalı idi.\nAmma sayt hazırda təmirdədir.\nUstalar deyir ki, “sabah hazır olacaq”.\nHansı sabah olduğu hələ məlum deyil. 😄',
];
---

<UserLayout title="Tanitim.az — Tezliklə">
  <main class="maintenance-page" data-messages={JSON.stringify(messages)}>
    <div class="maintenance-content">
      <header class="brand-block">
        <p class="wordmark">TANITIM.AZ</p>
        <nav class="project-links" aria-label="Digər layihələr">
          <a href="https://influencer.az/">influencer.az</a>
          <span aria-hidden="true">•</span>
          <a href="https://utm.az/">utm.az</a>
        </nav>
      </header>

      <p class="maintenance-message visible" aria-live="polite">{messages[0]}</p>

      <div class="message-progress" aria-hidden="true">
        {messages.map((_, index) => (
          <span class:list={["progress-dot", { active: index === 0 }]}></span>
        ))}
      </div>
    </div>
  </main>

  <script>
    const page = document.querySelector<HTMLElement>('.maintenance-page');
    const message = document.querySelector<HTMLElement>('.maintenance-message');
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.progress-dot'));

    if (page && message) {
      const messages = JSON.parse(page.dataset.messages ?? '[]') as string[];
      let currentIndex = Math.floor(Math.random() * messages.length);

      const showMessage = (index: number) => {
        message.classList.remove('visible');

        window.setTimeout(() => {
          message.textContent = messages[index];
          dots.forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === index));
          message.classList.add('visible');
        }, 180);
      };

      showMessage(currentIndex);

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.setInterval(() => {
          currentIndex = (currentIndex + 1) % messages.length;
          showMessage(currentIndex);
        }, 5200);
      }
    }
  </script>
</UserLayout>

<style>
  :global(html) {
    background: #fbfaf7;
  }

  :global(body) {
    margin: 0;
  }

  .maintenance-page {
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5rem) 1.5rem;
    background: #fbfaf7;
    color: #232323;
  }

  .maintenance-content {
    width: min(100%, 62rem);
    text-align: center;
  }

  .brand-block {
    margin-bottom: clamp(2.5rem, 7vh, 5rem);
  }

  .wordmark {
    margin: 0;
    color: #050505;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(3.5rem, 8vw, 8rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  .project-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1.15rem;
    color: #6f6b65;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(0.78rem, 1.2vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .project-links a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.2em;
    transition: color 180ms ease;
  }

  .project-links a:hover,
  .project-links a:focus-visible {
    color: #050505;
    text-decoration: underline;
  }

  .maintenance-message {
    display: grid;
    min-height: 3.6em;
    margin: 0;
    place-items: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 4.25vw, 4.5rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.035em;
    white-space: pre-line;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 360ms ease, transform 360ms ease;
  }

  .maintenance-message.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .message-progress {
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .progress-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #c9c0b6;
    transition: width 280ms ease, background-color 280ms ease;
  }

  .progress-dot.active {
    width: 1.8rem;
    background: #f06451;
  }

  @media (max-width: 640px) {
    .maintenance-page {
      padding-inline: 1.25rem;
    }

    .brand-block {
      margin-bottom: 2.75rem;
    }

    .wordmark {
      font-size: clamp(3.1rem, 16vw, 4.5rem);
      letter-spacing: -0.065em;
    }

    .maintenance-message {
      min-height: 6em;
      font-size: clamp(1.8rem, 8.5vw, 2.8rem);
      letter-spacing: -0.025em;
    }

    .message-progress {
      margin-top: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .maintenance-message,
    .progress-dot {
      transition: none;
    }
  }
</style>
