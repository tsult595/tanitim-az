---
interface Props {
  title: string;
  description: string;
  badge?: string;
  image?: string;
  class?: string; // Позволяет кастомизировать внешние стили
}

const { 
  title, 
  description, 
  badge, 
  image, 
  class: className 
} = Astro.props;
---

<div 
  class:list={[
    // 1. Базовая геометрия и пиксельные отступы
    "relative flex flex-col justify-between w-full p-6 sm:p-8",
    // 2. Скругления, границы и фоны
    "rounded-2xl border border-white/10 bg-slate-900/60 backdrop-blur-xl",
    // 3. Анимации и Hover-состояния
    "transition-all duration-300 hover:border-orange-500/50 hover:shadow-2xl hover:shadow-orange-500/10 hover:-translate-y-1",
    // 4. Кастомные классы снаружи (перекрывают или дополняют базовые)
    className
  ]}
>
  <!-- Беджик (если передан) -->
  {badge && (
    <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs font-semibold bg-orange-500/20 text-orange-400 border border-orange-500/30">
      {badge}
    </span>
  )}

  <!-- Картинка/Иконка -->
  {image && (
    <div class="mb-5 h-48 w-full overflow-hidden rounded-xl bg-slate-800">
      <img 
        src={image} 
        alt={title} 
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" 
      />
    </div>
  )}

  <!-- Контентная часть -->
  <div class="flex-1">
    <h3 class="text-xl font-bold text-white tracking-tight">{title}</h3>
    <p class="mt-2.5 text-sm leading-relaxed text-slate-300">
      {description}
    </p>
  </div>

  <!-- Дополнительный слот для кнопок или интерактивных элементов -->
  <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
    <slot />
  </div>
</div>