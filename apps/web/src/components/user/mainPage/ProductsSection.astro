---
// ProductsSection.astro
interface Product {
  name: string;
  description: string;
  buttonText: string;
  href: string;
  accent: string;
  imageUrl: string;
}

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = "Məhsullarımız",
  description = "Bizim məhsullarımız hər bir istifadəçinin ehtiyacına uyğun olaraq hazırlanmışdır.",
  class: className,
} = Astro.props;

const products: Product[] = [];
---

<section id="products-section" class:list={["w-full py-10 sm:py-12 md:py-16 lg:py-20", className]}>
  <div class="max-w-7xl mx-auto bg-white px-0 md:py-7">
    <div class="mb-6 sm:mb-8 md:mb-10 text-left px-0 sm:px-6 md:px-9 lg:px-12">
      <h2 data-i18n="products.title" class="text-2xl text-left sm:text-left md:text-3xl text-slate-900 tracking-tight mb-0">
        Məhsullarımız
      </h2>
    </div>

    <div data-products-list class="flex flex-col gap-20 sm:gap-28 bg-white rounded-2xl p-0 sm:p-6 md:p-9 lg:p-12">
    {
      products.map((product, i) => (
        <div
          class:list={[
            "grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center",
          ]}
        >
          {/* Мокап окна */}
          <div
            class:list={[
              "relative rounded-2xl overflow-hidden border border-slate-200 shadow-xl shadow-slate-200/50 bg-gradient-to-br",
              product.accent,
              i % 2 === 1 ? "lg:order-1" : "lg:order-2",
            ]}
          >
            {/* Верхняя панель браузера */}
            <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-100 backdrop-blur-sm">
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500" />
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500" />
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500" />
            </div>

            {/* Контент мокапа */}
            <div class="relative p-4 sm:p-6 min-h-[220px] sm:min-h-[320px] border-5 border-gray-100 rounded-b-2xl overflow-hidden">
                <img
                    src={product.imageUrl}
                    alt={product.name}
                    class="w-full h-full object-cover rounded-lg absolute top-0 left-0"
                />
            </div>
          </div>

          {/* Текстовый блок */}
          <div class:list={[
            "flex flex-col gap-6",
            i % 2 === 1 ? "lg:order-2" : "lg:order-1",
          ]}>
            <h3 class="text-xl sm:text-4xl tracking-tight leading-snug">
              {product.name}
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {product.description}
            </p>
            {product.buttonText && product.href && (
             <a
     
  href={product.href}
  class="
    w-fit
    items-center
    gap-3
    rounded-lg
    bg-orange-400
    text-white
    px-10
    py-2
    text-sm
    font-md
    transition-all
    hover:scale-105
    flex
  "
>
  {product.buttonText}
 
</a>
            )}
          </div>
         
        </div>
      ))
    }
    </div>
  </div>
</section>

<script>
  import { getProducts } from '../../../services/products.service';
  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
  }[character] ?? character));
  const loadProducts = async () => {
    const response = await getProducts();
    const section = document.querySelector<HTMLElement>('#products-section');
    if (!section) return;
    const container = section.querySelector('[data-products-list]');
    if (!container) return;
    container.innerHTML = response.filter((product) => product.isActive !== false).map((product, i) => `
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-gradient-to-br ${escapeHtml(product.accent)} shadow-xl shadow-slate-200/50 ${i % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}">
          <div class="flex items-center gap-1.5 bg-gray-100 px-4 py-3"><span class="h-2.5 w-2.5 rounded-full bg-gray-500"></span><span class="h-2.5 w-2.5 rounded-full bg-gray-500"></span><span class="h-2.5 w-2.5 rounded-full bg-gray-500"></span></div>
          <div class="relative min-h-[220px] overflow-hidden rounded-b-2xl border-5 border-gray-100 p-4 sm:min-h-[320px]"><img src="${escapeHtml(product.imageUrl)}" alt="${escapeHtml(product.name)}" class="absolute left-0 top-0 h-full w-full rounded-lg object-cover" /></div>
        </div>
        <div class="flex flex-col gap-6 ${i % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}"><h3 class="text-xl leading-snug tracking-tight sm:text-4xl">${escapeHtml(product.name)}</h3><p class="text-sm leading-relaxed text-slate-600 sm:text-base">${escapeHtml(product.description)}</p>${product.buttonText && product.href ? `<a href="${escapeHtml(product.href)}" class="flex w-fit items-center gap-3 rounded-lg bg-orange-400 px-10 py-2 text-sm text-white transition-all hover:scale-105">${escapeHtml(product.buttonText)}</a>` : ''}</div>
      </div>`).join('');
  };
  loadProducts().catch((error) => console.error('Failed to load products', error));
</script>
