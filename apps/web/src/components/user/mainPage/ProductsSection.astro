---
// ProductsSection.astro
interface Product {
  name: string;
  description: string;
  buttonText?: string;
  href?: string;
  accent?: string; // акцентный цвет мокапа
  imgSrc: string; // путь к изображению мокапа
}

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = "Məhsullarımız",
  description = "Bizim məhsullarımız hər bir istifadəçinin ehtiyacına uyğun olaraq hazırlanmışdır.",
  class: className,
} = Astro.props;

const products: Product[] = [
  {
    name: "INFLUENCER.AZ",
    description:
      "Azərbaycanın ən böyük və funksional influenser bazası. Kampaniyalarınızı planlaşdırın, uyğun influenserləri tapın və nəticələri real vaxtda izləyin.",
    buttonText: "ƏTRAFLI BAX",
    href: "https://influencer.az",
    accent: "from-rose-100 via-orange-50 to-white",
    imgSrc: "../../../../public/influencerpng.png",
  },
  {
    name: "UTM.AZ",
    description:
      "Kampaniyalarınızın effektivliyini ölçmək üçün mükəmməl analitika aləti. Linklərinizi qısaldın, izləyin və auditoriyanızı daha yaxşı anlayın.",
    buttonText: "PLATFORMAYA KEÇİD",
    href: "https://utm.az",
    accent: "from-emerald-100 via-green-50 to-white",
    imgSrc: "../../../../public/utm.az.png",
  },
];
---

<section id="products-section" class:list={["w-full py-10 sm:py-12 md:py-16 lg:py-20", className]}>
  <div class="max-w-7xl mx-auto bg-white px-0 md:py-7">
    <div class="mb-6 sm:mb-8 md:mb-10 text-left px-0 sm:px-6 md:px-9 lg:px-12">
      <h2 class="text-2xl md:text-3xl text-slate-900 tracking-tight mb-0">
        Məhsullarımız
      </h2>
    </div>

    <div class="flex flex-col gap-20 sm:gap-28 bg-white rounded-2xl p-0 sm:p-6 md:p-9 lg:p-12">
    {
      products.map((product, i) => (
        <div
          class:list={[
            "grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center",
          ]}
        >
          {/* Мокап окна */}
          <div
            class:list={[
              "relative rounded-2xl overflow-hidden border border-slate-200 shadow-xl shadow-slate-200/50 bg-gradient-to-br",
              product.accent,
              i % 2 === 1 ? "lg:order-1" : "lg:order-2",
            ]}
          >
            {/* Верхняя панель браузера */}
            <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-100 backdrop-blur-sm">
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500" />
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500" />
              <span class="w-2.5 h-2.5 rounded-full bg-gray-500" />
            </div>

            {/* Контент мокапа */}
            <div class="relative p-4 sm:p-6 min-h-[220px] sm:min-h-[320px] border-5 border-gray-100 rounded-b-2xl overflow-hidden">
                <img
                    src={product.imgSrc}
                    alt={product.name}
                    class="w-full h-full object-cover rounded-lg absolute top-0 left-0"
                />
            </div>
          </div>

          {/* Текстовый блок */}
          <div class:list={[
            "flex flex-col gap-6",
            i % 2 === 1 ? "lg:order-2" : "lg:order-1",
          ]}>
            <h3 class="text-xl sm:text-4xl tracking-tight leading-snug">
              {product.name}
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {product.description}
            </p>
            {product.buttonText && product.href && (
             <a
     
  href={product.href}
  class="
    w-fit
    items-center
    gap-3
    rounded-lg
    bg-orange-400
    text-white
    px-10
    py-2
    text-sm
    font-md
    transition-all
    hover:scale-105
    flex
  "
>
  {product.buttonText}
 
</a>
            )}
          </div>
         
        </div>
      ))
    }
    </div>
  </div>
</section>