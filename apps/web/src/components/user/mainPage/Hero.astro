---

import AboutSection from './AboutSection.astro'; 
import Header from './Header.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={["relative w-full h-screen overflow-hidden", className]}>
  <Header class="pointer-events-auto fixed top-0 right-0 left-0 z-50 p-6 sm:p-10" />
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
    <div 
      class="h-full w-full bg-cover bg-center"
      style="background-image: url('/test.avif');"
    >
    </div>
  </div>
  <AboutSection class="relative z-10 flex mt-20 w-full flex-col justify-between p-6 sm:p-10 sm:pt-36" />
</section>