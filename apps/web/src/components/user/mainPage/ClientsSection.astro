---
interface Client {
  name: string;
  logo: string;
}

interface Props {
  clients?: Client[];
  class?: string;
}

// Имена файлов писать буква в букву (на Linux-хостинге регистр важен)
const r2Url = '/api/r2';

const logoFiles = [
  "ABB", "Anker", "Avatr", "aviasales", "Azeerlotoreya", "Azpulmat",
  "Baghdan", "Bakcell", "Birmarket", "Carprisa", "Danone", "Dr.Oetker",
  "Elcore", "Entertainer", "Hp", "hyundai", "imTea", "Infinix", "Jale",
  "Lindt", "Mars", "Maseratti", "Mia", "Milla", "Mova", "MusicGallery",
  "Nar", "Natura", "Nestle", "PashaPay", "pinko", "PnG", "SAMSUNG",
  "SENSODYNE", "Solong", "Soundcore", "Starex", "TamStore", "TCL",
  "TECNO", "Tineco", "Veyseloglu", "YANGO",
];

const defaultClients: Client[] = logoFiles.map((file) => ({
  name: file,
  logo: `${r2Url}/clients/${file}.svg`,
}));

const { clients = defaultClients, class: className } = Astro.props;
---

<section id="clients-section" class:list={["w-full py-8 sm:py-10 md:py-6", className]}>
  <div class="mx-auto w-full max-w-7xl overflow-hidden bg-gray-100/60 py-4 md:py-6">

    <h2 class="mb-4 text-left text-2xl tracking-tight text-slate-900 sm:mb-6 sm:px-6 sm:text-left md:px-9 md:text-3xl lg:px-12">
      Müştərilərimiz
    </h2>

    <div class="grid grid-cols-3 gap-x-2 gap-y-1 px-3 sm:grid-cols-3 sm:px-4 md:grid-cols-4 lg:grid-cols-6">
      {clients.map((client) => (
        <div class="group flex h-20 items-center justify-center p-3 sm:h-24 md:h-28">
          <img
            src={client.logo}
            alt={client.name}
            loading="lazy"
            class="h-9 w-auto max-w-full object-contain opacity-90 transition-opacity duration-300 group-hover:opacity-100 sm:h-10 md:h-12"
          />
        </div>
      ))}
    </div>

  </div>
</section>