---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { 
  title = "Haqqımızda", 
  description = "Biz rəqəmsal həllər və animasiya sahəsində ixtisaslaşmış komandayıq.", 
  class: className 
} = Astro.props;
---

<div class:list={["p-6 backdrop-blur-md rounded-xl border border-white/10", className]}>
  <h2 class="text-2xl font-bold text-white">{title}</h2>
  <p class="mt-2 text-gray-200 leading-relaxed">
    {description}
  </p>
</div>