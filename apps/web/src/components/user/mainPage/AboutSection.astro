---
interface Props {
  class?: string; 
}

const { class: className } = Astro.props;
---

<div class:list={["p-6 backdrop-blur-md", className]}>
  <h2 class="text-2xl font-bold text-white">Haqqımızda</h2>
  <p class="mt-2 text-gray-200">
    Biz rəqəmsal həllər və animasiya sahəsində ixtisaslaşmış komandayıq.
  </p>
</div>