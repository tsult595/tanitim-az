---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { 

  class: className 
} = Astro.props;
---

<div class:list={[className]}>
  <section id="about-section" class:list={["w-full px-1 md:px-12 ", className]}>
    <div class="mx-auto flex max-w-7xl flex-col bg-white md:flex-row">

  <!-- Text -->
  <div class="flex w-full flex-col justify-center gap-8 py-8 md:w-1/2 md:py-0">
    <h1 class="text-5xl font-bold text-[#FF6D33] md:text-7xl">
      Biz Kimik?
    </h1>

    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit.
      Accusamus, saepe unde laboriosam numquam optio ipsa tempora
      veniam doloribus officiis. Natus?
    </p>

    <a
     href="#services-section"
     data-scroll="services-section"
      class="flex w-fit items-center gap-2 rounded-lg text-md font-semibold text-orange-500"
    >
      Xidmətlərimiz

      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </svg>
    </a>
  </div>

  <!-- Image -->
  <div class="relative w-full shrink-0 md:w-1/2">
    <img
      src="/img.jpeg"
      class="h-full w-full object-cover"
      alt=""
    />
  </div>

</div>
  </section>
</div>