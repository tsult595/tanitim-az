---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { 
  title = "Haqqımızda", 
  description = "Biz rəqəmsal həllər və animasiya sahəsində ixtisaslaşmış komandayıq.", 
  class: className 
} = Astro.props;
---

<!-- Внешняя обертка отвечает за w-full, z-index и кастомные внешние классы -->
<div class:list={[className]}>
  <!-- Внутренний контейнер фиксирует ширину, центрирует и задает стили карточки -->
  <div class="max-w-7xl mx-auto px-6 sm:px-10 py-8 sm:py-12 backdrop-blur-md rounded-xl border border-white/10 bg-slate-900/40">
    <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
      {title}
    </h2>
    <p class="mt-3 text-sm sm:text-base text-slate-200 leading-relaxed max-w-3xl">
      {description}
    </p>
  </div>
</div>