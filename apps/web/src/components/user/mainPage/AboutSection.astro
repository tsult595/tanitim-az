---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { 
  title = "Haqqımızda", 
  description = "Biz rəqəmsal həllər və animasiya sahəsində ixtisaslaşmış komandayıq.", 
  class: className 
} = Astro.props;
---

<div class:list={[className]}>
  <div class="px-4 py-6 sm:px-8 sm:py-10 md:px-10 md:py-12 lg:px-12 lg:py-14 backdrop-blur-md rounded-xl border bg-amber-200 border-white/10">
    <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-white tracking-tight">
      {title}
    </h2>
    <p class="mt-2 sm:mt-3 md:mt-4 text-sm sm:text-base md:text-lg text-slate-200 leading-relaxed max-w-3xl">
      {description}
    </p>
  </div>
</div>