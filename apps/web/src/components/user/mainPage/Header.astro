---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const navLinks = [
  { id: "about-section", label: "Haqqımızda" },
  { id: "services-section", label: "Xidmətlər" },
  { id: "clients-section", label: "Müştərilər" },
  { id: "products-section", label: "Məhsullar" },
  { id: "contact-section", label: "Əlaqə" },
];
---

<header class:list={["sticky top-0 z-50 h-16 sm:h-20  bg-white/90 backdrop-blur-md border-b border-slate-100 transition-all", className]}>
  <nav class="max-w-7xl mx-auto w-full h-full flex items-center justify-between px-5 md:px-15 lg:px-22 xl:px-12">
    <!-- Логотип -->
    <a class="h-8 w-20 sm:h-9 sm:w-24 flex-shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded-lg" href="/">
      <img
        src="/tanitim_logo.png"
        alt="Logo"
        class="h-full w-full object-contain"
        width="96"
        height="36"
      />
    </a>

    <!-- Правый блок: Навигация + Blog + Язык + Бургер -->
    <div class="flex items-center gap-6 lg:gap-8">
      <!-- Десктоп Меню -->
      <ul class="hidden items-center gap-6 lg:gap-8 lg:flex text-xs font-semibold list-none m-0 p-0">
        {navLinks.map((link) => (
          <li>
            <a 
              href={`/#${link.id}`} 
              data-scroll={link.id} 
              class="hover:text-[#FE7930] uppercase tracking-wider text-slate-800 transition-colors py-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Кнопка Blog -->
      <a
        href="/user/blogs"
        class="inline-flex bg-[#FE7930] hover:bg-[#e06520] rounded-full px-5 sm:px-6 py-2 sm:py-2.5 text-xs font-bold uppercase tracking-wider text-white transition-all hover:scale-105 active:scale-95 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-orange-500"
      >
        Blog
      </a>

      <!-- Языковой селектор (Desktop) -->
      <div class="relative group py-2 hidden lg:block focus-within:block">
        <button 
          type="button" 
          aria-haspopup="true"
          class="flex items-center gap-1 text-xs font-semibold uppercase text-slate-800 hover:text-[#FE7930] transition-colors cursor-pointer bg-transparent border-none p-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded"
        >
          <span>AZ</span>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-[#FE7930] transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute right-0 top-full hidden group-hover:flex group-focus-within:flex flex-col bg-white border border-slate-100 rounded-xl shadow-xl p-1.5 min-w-[70px] z-50">
          <a href="?lang=ru" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-[#FE7930] hover:bg-orange-50/50 rounded-lg text-left transition-colors">
            RU
          </a>
          <a href="?lang=en" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-[#FE7930] hover:bg-orange-50/50 rounded-lg text-left transition-colors">
            EN
          </a>
        </div>
      </div>

      <!-- Бургер-кнопка (Мобилка) -->
      <button
        type="button"
        id="burger-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="lg:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 bg-transparent border-none cursor-pointer rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500"
      >
        <span class="burger-line block w-6 h-0.5 bg-slate-800 transition-transform duration-300 origin-center"></span>
        <span class="burger-line block w-6 h-0.5 bg-slate-800 transition-opacity duration-300"></span>
        <span class="burger-line block w-6 h-0.5 bg-slate-800 transition-transform duration-300 origin-center"></span>
      </button>
    </div>
  </nav>

  <!-- Мобильное меню (drawer) -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-x-0 top-16 sm:top-20 h-[calc(100vh-4rem)] bg-white/95 backdrop-blur-md flex flex-col items-center justify-start pt-12 gap-6 text-base font-semibold text-slate-800 transition-all duration-300 ease-in-out opacity-0 pointer-events-none -translate-y-4 overflow-y-auto"
  >
    {navLinks.map((link) => (
      <a 
        href={`/#${link.id}`} 
        data-scroll={link.id} 
        class="hover:text-[#FE7930] uppercase tracking-wider transition-colors py-1"
      >
        {link.label}
      </a>
    ))}

    <div class="flex gap-4 mt-6 pt-6 border-t border-slate-200/60 w-1/2 justify-center">
      <a href="?lang=az" class="text-sm font-semibold text-slate-800 hover:text-[#FE7930]">AZ</a>
      <a href="?lang=ru" class="text-sm font-semibold text-slate-500 hover:text-[#FE7930]">RU</a>
      <a href="?lang=en" class="text-sm font-semibold text-slate-500 hover:text-[#FE7930]">EN</a>
    </div>
  </div>
</header>

<style>
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  #burger-btn.open .burger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #burger-btn.open .burger-line:nth-child(2) {
    opacity: 0;
  }
  #burger-btn.open .burger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const initHeader = () => {
    const burgerBtn = document.getElementById('burger-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    const closeMenu = () => {
      burgerBtn?.classList.remove('open');
      mobileMenu?.classList.remove('open');
      burgerBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    burgerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = mobileMenu?.classList.toggle('open');
      burgerBtn.classList.toggle('open');
      burgerBtn.setAttribute('aria-expanded', String(!!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Плавный скролл по навигации
    const scrollLinks = document.querySelectorAll('[data-scroll]');
    scrollLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-scroll');
        if (!targetId) return;

        closeMenu();

        if (window.location.pathname === '/' || window.location.pathname === '') {
          const element = document.getElementById(targetId);
          if (element) {
            e.preventDefault();
            element.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', `/#${targetId}`);
          }
        }
      });
    });

    // Закрытие мобильного меню при клике вне него
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (mobileMenu?.classList.contains('open') && !mobileMenu.contains(target) && !burgerBtn?.contains(target)) {
        closeMenu();
      }
    });

    // Закрытие при нажатии Esc
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  };

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>