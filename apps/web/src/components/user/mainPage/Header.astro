---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={["h-20 sm:px-1", className]}>
  <nav class="max-w-7xl mx-auto w-full h-full flex items-center justify-between text-white">
    <!-- Логотип -->
    <div class="h-9 w-25">
      <img
        src="/tanitim_logo.png"
        alt="Logo"
        class="h-full w-full object-contain"
      />
    </div>

    <!-- Ссылки с плавной прокруткой -->
    <div class="flex-1 hidden items-center justify-center gap-8 md:flex text-sm font-medium">
      <button 
        type="button" 
        data-scroll="about-section" 
        class="hover:text-orange-500 text-sm text-slate-700 transition-colors cursor-pointer bg-transparent border-none p-0"
      >
        Haqqımızda
      </button>

      <button 
        type="button" 
        data-scroll="services-section" 
        class="hover:text-orange-500 text-sm text-slate-700 transition-colors cursor-pointer bg-transparent border-none p-0"
      >
        Xidmətlər
      </button>

      <button 
        type="button" 
        data-scroll="clients-section" 
        class="hover:text-orange-500 text-sm text-slate-700 transition-colors cursor-pointer bg-transparent border-none p-0"
      >
        Müştərilər
      </button>

      <button 
        type="button" 
        data-scroll="products-section" 
        class="hover:text-orange-500 text-sm text-slate-700 transition-colors cursor-pointer bg-transparent border-none p-0"
      >
        Məhsullar
      </button>

      <button 
        type="button" 
        data-scroll="contact-section" 
        class="hover:text-orange-500 text-sm text-slate-700 transition-colors cursor-pointer bg-transparent border-none p-0"
      >
        Əlaqə
      </button>

      <button
        type="button"
        data-scroll="contact-section"
        class="rounded-full bg-[#F0692A] px-5 py-2.5 text-sm font-bold text-black transition-transform hover:scale-105 active:scale-95 select-none cursor-pointer border-none"
      >
        Sifariş et
      </button>
    </div>

   
     <div class="relative group py-2">
      <button type="button" class="flex items-center gap-1 text-sm font-semibold text-slate-800 hover:text-orange-500 transition-colors cursor-pointer bg-transparent border-none p-0">
        <span>AZ</span>
        <svg class="w-3.5 h-3.5 text-orange-700 group-hover:text-slate-900 transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div class="absolute right-0 top-full hidden group-hover:flex flex-col bg-white border border-slate-200/80 rounded-xl shadow-lg p-1.5 min-w-[70px] z-50">
        <button type="button" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-orange-500 hover:bg-slate-50 rounded-lg text-left transition-colors cursor-pointer bg-transparent border-none">
          RU
        </button>
        <button type="button" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-orange-500 hover:bg-slate-50 rounded-lg text-left transition-colors cursor-pointer bg-transparent border-none">
          EN
        </button>
      </div>
    </div> 
  </nav>
</header>

<script>
  // Логика скролла для Astro
  const initScroll = () => {
    const scrollButtons = document.querySelectorAll('[data-scroll]');
    
    scrollButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-scroll');
        if (!targetId) return;

        if (window.location.pathname === '/') {
          const element = document.getElementById(targetId);
          if (element) {
            element.scrollIntoView({ behavior: 'smooth' });
          }
        } else {
          window.location.href = `/#${targetId}`;
        }
      });
    });
  };

  initScroll();
  document.addEventListener('astro:after-swap', initScroll);
</script>