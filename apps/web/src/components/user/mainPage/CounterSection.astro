---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[
    "bg-[#f5f4f2]",
    "sm:px-6",
    "lg:px-10",
    "xl:px-0",
    "sm:py-12",
    "md:py-14",
    "lg:py-16",
    className,
  ]}
>
  <div class="relative mx-auto max-w-7xl">
    
  

    <!-- White inner card -->
    <div
      class="relative z-10 max-w-7xl m-auto grid grid-cols-1 gap-6 rounded-xl bg-white p-6 shadow-lg sm:grid-cols-2 sm:gap-8 sm:p-8 md:grid-cols-4 md:gap-10 md:p-10"
    >
      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Ugurlu Müştərilər
        </div>
      </div>

      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Tamamlanmış Layihələr
        </div>
      </div>

      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Peşəkar Xidmətlər
        </div>
      </div>

      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          İllik Təcrübə
        </div>
      </div>
    </div>

  </div>
</section>