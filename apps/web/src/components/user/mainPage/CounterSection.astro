---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[
    "sm:px-10",
    "sm:py-12",
    "md:py-14",
    "lg:py-16",
    className,
  ]}
>
  <div class="relative mx-auto max-w-7xl">
    
    <!-- White inner card -->
    <div
      class="relative z-10 max-w-7xl m-auto grid grid-cols-2 gap-6 rounded-xl bg-white p-6 shadow-lg sm:grid-cols-2 sm:gap-8 sm:p-8 md:grid-cols-4 md:gap-10 md:p-5"
    >
      <!-- Item 1 -->
      <div class="flex flex-col items-center  gap-2 sm:gap-4 h-full">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Uğurlu Müştərilər
        </div>
      </div>

      <!-- Item 2 -->
      <div class="flex flex-col items-center gap-2 sm:gap-4 h-full">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Tamamlanmış Layihələr
        </div>
      </div>

      <!-- Item 3 -->
      <div class="flex flex-col items-center gap-2 sm:gap-4 h-full">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Peşəkar Xidmətlər
        </div>
      </div>

      <!-- Item 4 -->
      <div class="flex flex-col items-center  gap-2 sm:gap-4 h-full">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          İllik Təcrübə
        </div>
      </div>
    </div>

  </div>
</section>