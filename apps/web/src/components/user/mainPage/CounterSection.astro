---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  id="stats-section"
  class:list={[
    "sm:px-10",
    "sm:py-12",
    "md:py-14",
    "lg:py-16",
    className,
  ]}
>
  <div class="relative mx-auto max-w-7xl">

    <!-- White inner card -->
    <div
      class="relative z-10 max-w-7xl m-auto grid grid-cols-2 gap-6 rounded-xl bg-white p-6 shadow-lg sm:grid-cols-2 sm:gap-8 sm:p-8 md:grid-cols-4 md:gap-10 md:p-5"
    >
      <!-- Item 1 -->
      <div class="flex flex-col items-center gap-2 sm:gap-4 h-full">
        <div id="twelveNull" class="text-4xl font-bold text-orange-400">0+</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Uğurlu Layihələr
        </div>
      </div>

      <!-- Item 2 -->
      <div class="flex flex-col items-center gap-2 sm:gap-4 h-full">
        <div id="fourFive" class="text-4xl font-bold text-orange-400">0+</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Əməkdaşlıq Etdiyimiz Brendlər
        </div>
      </div>

      <!-- Item 3 -->
      <div class="flex flex-col items-center gap-2 sm:gap-4 h-full">
        <div id="tventyFive" class="text-4xl font-bold text-orange-400">0+</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Həyata Keçirilən Kampaniyalar
        </div>
      </div>

      <!-- Item 4 -->
      <div class="flex flex-col items-center gap-2 sm:gap-4 h-full">
        <div id="fifty" class="text-4xl font-bold text-orange-400">0M+</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Çatılan Auditoriya
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const animateCounter = (
    element: HTMLElement | null,
    target: number,
    suffix = '+',
    duration = 1200
  ) => {
    if (!element) return;

    let current = 0;
    const steps = Math.ceil(duration / 20);
    const step = target / steps;

    const timer = setInterval(() => {
      current += step;
      if (current >= target) {
        element.textContent = `${target}${suffix}`;
        clearInterval(timer);
      } else {
        element.textContent = `${Math.floor(current)}${suffix}`;
      }
    }, 20);
  };

  const counters = [
    { el: document.getElementById('twelveNull'), target: 1200, suffix: '+' },
    { el: document.getElementById('fourFive'), target: 45, suffix: '+' },
    { el: document.getElementById('tventyFive'), target: 250, suffix: '+' },
    { el: document.getElementById('fifty'), target: 50, suffix: 'M+' },
  ];

  const section = document.getElementById('stats-section');

  if (section) {
    let hasAnimated = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasAnimated) {
            hasAnimated = true;
            counters.forEach(({ el, target, suffix }) => animateCounter(el, target, suffix));
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(section);
  }
</script>