---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[
    "bg-[#F7F5F2]",
    "px-4",
    "sm:px-6",
    "lg:px-10",
    "xl:px-0",
    "py-10",
    "sm:py-12",
    "md:py-14",
    "lg:py-16",
    className,
  ]}
>
  <div class="relative mx-auto max-w-7xl">
    
    <!-- Background effects -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 -left-24 h-[420px] w-[420px] rounded-full bg-[#F0692A]/25 blur-[90px]"></div>

      <div class="absolute -top-10 right-0 h-[380px] w-[380px] rounded-full bg-[#F5AD82]/35 blur-[90px]"></div>

      <div class="absolute bottom-0 left-10 h-[360px] w-[360px] rounded-full bg-[#E2ECE9] blur-[80px]"></div>
    </div>

    <!-- White inner card -->
    <div
      class="relative z-10 grid grid-cols-1 gap-6 rounded-xl bg-white p-6 shadow-lg sm:grid-cols-2 sm:gap-8 sm:p-8 md:grid-cols-4 md:gap-10 md:p-10"
    >
      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Ugurlu Müştərilər
        </div>
      </div>

      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Tamamlanmış Layihələr
        </div>
      </div>

      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          Peşəkar Xidmətlər
        </div>
      </div>

      <div class="flex flex-col items-center justify-center gap-2 sm:gap-5">
        <div class="text-4xl font-bold text-orange-400">0</div>
        <div class="text-center text-lg font-medium text-gray-600">
          İllik Təcrübə
        </div>
      </div>
    </div>

  </div>
</section>