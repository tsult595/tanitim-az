---
import CounterSection from './CounterSection.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section id="contact-section"
  class:list={[
    "w-full bg-[#f5f4f2] py-10 sm:py-14 lg:py-16",
    className,
   
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-11">

    <!-- Title -->
    <h2 class="text-2xl md:text-3xl text-slate-900 tracking-tight mb-5 sm:mb-6 md:mb-8">
      Əlaqə
    </h2>

    <!-- Main Content -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">

      <!-- Form Card -->
      <div
        class="rounded-2xl border border-black/5 bg-white p-5 shadow-sm sm:p-7 lg:p-8"
      >
        <h3 class="text-lg font-bold text-[#3d3d3d]">
          Bizimlə Əlaqə
        </h3>

        <p class="mt-2 text-sm leading-6 text-gray-500">
          Layihəniz haqqında məlumat almaq və ya təklif almaq üçün bizimlə əlaqə saxlayın.
        </p>

        <form class="mt-6 space-y-4">

          <!-- Name -->
          <div>
            <label
              for="name"
              class="mb-2 block text-xs font-medium text-gray-500"
            >
              AD, SOYAD
            </label>

            <input
              id="name"
              type="text"
              placeholder="Adınızı daxil edin"
              class="h-11 w-full rounded-lg border border-gray-200 bg-[#f7f7f7] px-4 text-sm text-gray-700 outline-none transition placeholder:text-gray-400 focus:border-orange-400 focus:bg-white focus:ring-4 focus:ring-orange-400/10"
            />
          </div>

          <!-- Subject -->
          <div>
            <label
              for="subject"
              class="mb-2 block text-xs font-medium text-gray-500"
            >
              MÖVZU
            </label>

            <input
              id="subject"
              type="text"
              placeholder="Mövzunu daxil edin"
              class="h-11 w-full rounded-lg border border-gray-200 bg-[#f7f7f7] px-4 text-sm text-gray-700 outline-none transition placeholder:text-gray-400 focus:border-orange-400 focus:bg-white focus:ring-4 focus:ring-orange-400/10"
            />
          </div>

          <!-- Phone -->
          <div>
            <label
              for="phone"
              class="mb-2 block text-xs font-medium text-gray-500"
            >
              ƏLAQƏ NÖMRƏSİ
            </label>

            <input
              id="phone"
              type="tel"
              placeholder="+994 50 000 00 00"
              class="h-11 w-full rounded-lg border border-gray-200 bg-[#f7f7f7] px-4 text-sm text-gray-700 outline-none transition placeholder:text-gray-400 focus:border-orange-400 focus:bg-white focus:ring-4 focus:ring-orange-400/10"
            />
          </div>

          <!-- Message -->
          <div>
            <label
              for="message"
              class="mb-2 block text-xs font-medium text-gray-500"
            >
              MESAJ
            </label>

            <textarea
              id="message"
              rows="4"
              placeholder="Layihəniz barədə qısa məlumat..."
              class="w-full resize-none rounded-lg border border-gray-200 bg-[#f7f7f7] px-4 py-3 text-sm text-gray-700 outline-none transition placeholder:text-gray-400 focus:border-orange-400 focus:bg-white focus:ring-4 focus:ring-orange-400/10"
            ></textarea>
          </div>

          <!-- Button -->
          <button
            type="submit"
            class="flex h-12 w-full items-center justify-center gap-2 rounded-lg bg-[#ff5a24] px-6 text-sm font-semibold text-white shadow-lg shadow-orange-500/20 transition hover:bg-[#e94d1b] active:scale-[0.98]"
          >
            GÖNDƏR

            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </button>

        </form>
      </div>

      <!-- Map + Contact Info -->
      <div class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm">

        <!-- Map -->
        <div class="relative min-h-[320px] flex-1 sm:min-h-[400px]">

          <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d24316.514617834797!2d49.83997095!3d40.374183699999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sru!2saz!4v1788505373291!5m2!1sru!2saz"
            class="absolute inset-0 h-full w-full"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Xəritə"
          ></iframe>

        </div>

        <!-- Bottom Contact Info -->
        <div
          class="grid grid-cols-1 gap-3 border-t border-gray-100 bg-white px-5 py-4 text-xs text-gray-500 sm:grid-cols-3"
        >

          <a
            href="tel:+994124000000"
            class="flex items-center gap-2 transition hover:text-[#ff5a24]"
          >
            <span class="text-[#ff5a24]">●</span>
            +994 12 400 00 00
          </a>

          <a
            href="mailto:info@tanitim.az"
            class="flex items-center gap-2 transition hover:text-[#ff5a24]"
          >
            <span class="text-[#ff5a24]">●</span>
            info@tanitim.az
          </a>

          <div class="flex items-center gap-2 text-gray-400">
            <span>Əlaqə</span>
          </div>

        </div>

      </div>
    </div>
    <CounterSection class="mt-10" />
  </div>
</section>