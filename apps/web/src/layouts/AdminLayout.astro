---
// src/layouts/AdminLayout.astro
import AdminSidebar from '../components/admin/mainAdminPage/AdminSidebar.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Admin Panel" } = Astro.props;
---

<!DOCTYPE html>
<html lang="az">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-slate-50">
    <div class="flex h-screen overflow-hidden">
      <!-- transition:persist — сайдбар НЕ пересоздаётся при переходах -->
      <AdminSidebar transition:persist="admin-sidebar" />

      <section class="flex-1 flex flex-col overflow-hidden">
        <header class="h-16 flex items-center justify-between px-6 border-b border-slate-200 bg-white flex-shrink-0">
          <h1 class="text-lg font-semibold text-slate-900">{title}</h1>
        </header>

        <main class="flex-1 overflow-y-auto pt-5 p-6">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 xl:px-0">
            <slot />
          </div>
        </main>
      </section>
    </div>
  </body>
</html>