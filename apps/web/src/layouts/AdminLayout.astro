---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;

const navItems = [
	{ title: 'Dashboard', path: '/admin', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
	{ title: 'Bloglar', path: '/admin/blogs', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.25-2.25l-2-2' },
	{ title: 'Xidmətlər', path: '/admin/services', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
	{ title: 'Müştərilər', path: '/admin/clients', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
	{ title: 'Kontaktlar', path: '/admin/contacts', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
	{ title: 'Tərcümələr', path: '/admin/translations', icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="az">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Admin Panel - Tanitim.az" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Admin Panel</title>
	</head>
	<body class="bg-gray-100 text-gray-900 flex h-screen overflow-hidden">
		<!-- Sidebar -->
		<aside class="bg-slate-800 text-white w-64 flex-shrink-0 flex flex-col hidden md:flex h-full">
			<div class="h-16 flex items-center px-6 border-b border-slate-700">
				<a href="/admin" class="text-xl font-bold flex items-center gap-2">
					<span class="text-[#F0692A]">Tanitim</span> Admin
				</a>
			</div>
			<nav class="flex-1 overflow-y-auto py-4">
				<ul class="space-y-1">
					{navItems.map(item => {
						const isActive = currentPath === item.path || (item.path !== '/admin' && currentPath.startsWith(item.path));
						return (
							<li>
								<a 
									href={item.path} 
									class={`flex items-center gap-3 px-6 py-3 transition-colors ${isActive ? 'bg-slate-700 text-[#F0692A] border-l-4 border-[#F0692A]' : 'text-gray-300 hover:bg-slate-700 hover:text-white border-l-4 border-transparent'}`}
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
									</svg>
									{item.title}
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
			<div class="p-4 border-t border-slate-700">
				<a href="/" class="flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors" target="_blank">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
					</svg>
					Sayta qayıt
				</a>
			</div>
		</aside>

		<!-- Mobile Header & Navigation (Placeholder for now) -->
		<div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-slate-800 text-white flex items-center justify-between px-4 z-50">
			<a href="/admin" class="text-lg font-bold"><span class="text-[#F0692A]">Tanitim</span> Admin</a>
			<button id="mobile-menu-btn" class="p-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>

		<!-- Main Content -->
		<main class="flex-1 flex flex-col h-full w-full overflow-hidden bg-gray-50 md:mt-0 mt-16">
			<!-- Header -->
			<header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 flex-shrink-0">
				<h1 class="text-xl font-semibold text-gray-800">{title}</h1>
				<div class="flex items-center gap-4">
					<div class="h-8 w-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold">
						A
					</div>
				</div>
			</header>

			<!-- Content Area -->
			<div class="flex-1 overflow-auto p-6">
				<slot />
			</div>
		</main>

		<script>
			// Basic mobile menu toggle
			document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
				alert('Mobil menyu tezliklə əlavə ediləcək');
			});
		</script>
	</body>
</html>
