{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanidim-az-web",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "env": {
    "beta": {
      "name": "tanidim-az-web-beta",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "beta.tanitim.az",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    },
    "production": {
      "name": "tanidim-az-web",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "tanitim.az",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
