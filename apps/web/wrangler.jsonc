{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanitim-personal-web",
  "compatibility_date": "2026-08-28",
  "account_id": "dd992ffc582324e1ca427b11b048d70e",
  "workers_dev": false,
  "vars": {
    "MAINTENANCE_MODE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanitim-personal",
      "database_id": "58c37af0-3023-41bd-bdc3-28faa8cb1138",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    "beta": {
      "name": "tanitim-personal-web-beta",
      "workers_dev": false,
      "vars": {
        "MAINTENANCE_MODE": "false"
      },
      "routes": [
        {
          "pattern": "beta.tanitim.az",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "f04036041970432cbd4472c230634e93"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanitim-personal",
          "database_id": "58c37af0-3023-41bd-bdc3-28faa8cb1138",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "tanitim-personal-web",
      "workers_dev": false,
      "vars": {
        "MAINTENANCE_MODE": "true"
      },
      "routes": [
        {
          "pattern": "tanitim.az",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "f04036041970432cbd4472c230634e93"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanitim-personal",
          "database_id": "58c37af0-3023-41bd-bdc3-28faa8cb1138",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
