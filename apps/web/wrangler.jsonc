{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanidim-az-web",
  "compatibility_date": "2026-08-28",
  "account_id": "52b9359bbe5496b5651196030199414a",
  "workers_dev": false,
  "env": {
    "beta": {
      "name": "tanidim-az-web-beta",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "beta.tanitim.az",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "tanitim"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanitim",
          "database_id": "43da2555-5ea0-4f92-ba7a-6298bf015e1c",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "tanidim-az-web",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "tanitim.az",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "tanitim"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanitim",
          "database_id": "43da2555-5ea0-4f92-ba7a-6298bf015e1c",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
